  "verifiedFindings": [
    {
      "id": "A15-F01",
      "priority": "P1",
      "kind": "reproducible_UI_journey_defect",
      "finding": "Full profile analytics search->clear->visible7day selection remainsToday. Fresh isolated overview selects7/30 successfully. The full journey is not fixed.",
      "evidence": [
        "BaselineCodeAndMainUI.xcresult failed chart expectation",
        "SearchPeriodReproduction.xcresult and screenshot AD3EE191-CC8A-43F8-8C17-BA0AFC61C8B8.png: chart absent becauseToday still selected",
        "SearchPeriodSelectionWait.xcresult: no selection even after settling/readback",
        "SearchActualVisibleFrame.xcresult: visibility/viewport geometry asserted; selected-period readback still fails",
        "FullUnitsFreshPeriodAndStartup.xcresult: fresh7/30 control selection passes"
      ],
      "boundary": "Exact interaction root cause still requires focus/keyboard/scroll investigation; this is not a calculation failure and the initial offscreen-driver explanation was insufficient. Do not weaken selection assertions or mark this verified by the fresh-control test."
    },
    {
      "id": "A15-F02",
      "priority": "P2",
      "kind": "observed_visual_copy_defect",
      "finding": "Normal-size empty-state explanation is truncated with an ellipsis. Empty7/30 copy includes technical rollup wording.",
      "evidence": [
        "expanded-captures/F65A2ABB-8B8E-4B3F-B115-A280E2A755CB.png",
        "owner_analytics.empty.rollup_message localization",
        "EmptyStateCard message line limit"
      ],
      "proposal": "Shorten user-facing explanations and allow required status text to wrap completely; remove rollup jargon."
    },
    {
      "id": "A15-F03",
      "priority": "P2",
      "kind": "information_architecture_improvement",
      "finding": "The current-account count occupies a nested full-width metric card with repeated headings and explanation, pushing overview and charts far down the page. Both normal themes and large text were inspected.",
      "evidence": [
        "baseline-captures/7D536C8B-3439-4A71-AA03-50BC0D6819E3.png",
        "baseline-captures/D7866FB2-0860-4CFB-AFA0-EA0D401372D5.png"
      ],
      "proposal": "Compact summary with clearly separate current-account vs selected-period metrics; retain shared visual style and inline banner totals."
    },
    {
      "id": "A15-F04",
      "priority": "P2",
      "kind": "freshness_period_semantics",
      "finding": "Live account count, live daily counters, hourly7/30/user rollups and5minute UTC banner rollups share one screen. The copy mentions5minute refresh without sufficiently separating sources. General periods useVienna, bannersUTC; Today comparison uses a whole previous day.",
      "evidence": [
        "analytics-schedules.json: actual enabled jobs, status0",
        "AnalyticsPresentationText.swift",
        "fetchSnapshot reads daily/rollups independently",
        "previousDates(for:anchoredAt:)"
      ],
      "proposal": "Make each source cutoff/freshness explicit, clarify incompleteToday comparison, and keep selected-period reporting coherent. Do not simply increase expensive full-user scan frequency."
    },
    {
      "id": "A15-F05",
      "priority": "P2",
      "kind": "performance_improvement",
      "finding": "Overview reads daily range plus3 rollups in parallel, account count and banner overview separately. View-local60second caches disappear when a destination is recreated; manual load methods can issue overlapping same-period reads.",
      "evidence": [
        "FirestoreOwnerAnalyticsRepository.fetchSnapshot",
        "OwnerAnalyticsViewModel.load/loadIfNeeded",
        "BannerAnalyticsOverviewSection and RegisteredUserCountCard"
      ],
      "proposal": "Share bounded owner/session-specific snapshots and in-flight reads, preserving refresh and role/session invalidation; avoid persisting private analytics by default.",
      "boundary": "Read counts and cache lifetime are code-backed; no physical iPhone load-time improvement has been measured or claimed."
    },
    {
      "id": "A15-F06",
      "priority": "P2",
      "kind": "defensive_decoding_gap_not_observed_corrupt_production_data",
      "finding": "Repository intValue converts arbitrary Double directly toInt and acceptsNSNumber without consistently excluding booleans/fractions. Nonfinite or out-of-rangeDouble can trap instead of presenting a data-format error.",
      "evidence": [
        "FirestoreOwnerAnalyticsRepository.swift:1356 intValue",
        "Daily and detail metric decoding call that helper; user/top validators are stricter"
      ],
      "proposal": "Use checked finite integral nonnegative conversion and safe sum handling; malformed sources must be reported rather than silently shown as authoritative zeros.",
      "boundary": "No malformed present numeric metric values found in the production aggregate sample."
    },
    {
      "id": "A15-F07",
      "priority": "P3",
      "kind": "search_scope_clarity",
      "finding": "Popular rankings are capped at20items per content type in7/30rollups. Search filters loaded report content; it is not a global search of all historical posts. Top sums need not equal all view totals.",
      "evidence": [
        "mergeTopContentSources .slice(0,20)",
        "production top20 sums differ from full daily counts by design"
      ],
      "proposal": "Clearly label ranking/search scope and show the loaded-item limit; preserve genuine totals."
    }
  ],
