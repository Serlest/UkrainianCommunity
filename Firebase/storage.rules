rules_version = '2';
service firebase.storage {
  match /b/{bucket}/o {
    function isSignedIn() {
      return request.auth != null;
    }

    function isSelf(uid) {
      return isSignedIn() && request.auth.uid == uid;
    }

    function existsUser(uid) {
      return firestore.exists(/databases/(default)/documents/users/$(uid));
    }

    function userDoc(uid) {
      return firestore.get(/databases/(default)/documents/users/$(uid));
    }

    function userData(uid) {
      return userDoc(uid).data;
    }

    function currentUserData() {
      return userData(request.auth.uid);
    }

    function isActiveUser() {
      return isSignedIn()
        && existsUser(request.auth.uid)
        && (
          !('accountStatus' in currentUserData())
          || currentUserData().accountStatus == 'active'
          || currentUserData().accountStatus == 'warned'
        )
        && (
          !('blockState' in currentUserData())
          || currentUserData().blockState == 'active'
          || currentUserData().blockState == 'warned'
        );
    }

    function isVerifiedEmailUser() {
      return isSignedIn() && request.auth.token.email_verified == true;
    }

    function isTOTPAuthenticated() {
      return isSignedIn()
        && ('firebase' in request.auth.token)
        && ('sign_in_second_factor' in request.auth.token.firebase)
        && request.auth.token.firebase.sign_in_second_factor == 'totp';
    }

    function satisfiesPrivilegedMFARequirement(data) {
      return !(
        data.get('requiresMultiFactorAuth', false) == true
        && data.get('globalRole', 'user') in ['owner', 'admin']
      ) || isTOTPAuthenticated();
    }

    function hasCurrentLegalAcknowledgements(data) {
      let termsPath = /databases/(default)/documents/legalDocuments/terms;
      let privacyPath = /databases/(default)/documents/legalDocuments/privacy;
      return data.get('acceptedTermsVersion', '') == firestore.get(termsPath).data.activeVersion
        && data.get('acceptedPrivacyVersion', '') == firestore.get(privacyPath).data.activeVersion;
    }

    function isVerifiedActiveUser() {
      return isVerifiedEmailUser()
        && isActiveUser()
        && satisfiesPrivilegedMFARequirement(currentUserData())
        && hasCurrentLegalAcknowledgements(currentUserData());
    }

    function isOwner() {
      return isVerifiedActiveUser()
        && ('globalRole' in currentUserData())
        && currentUserData().globalRole == 'owner';
    }

    function isAppAdmin() {
      return isVerifiedActiveUser()
        && ('globalRole' in currentUserData())
        && currentUserData().globalRole == 'admin';
    }

    function canModerateSection(section) {
      return section is string && (isOwner() || isAppAdmin());
    }

    function canManageContentImages(section) {
      return section is string && isOwner();
    }

    function organizationExists(organizationId) {
      return organizationId is string
        && firestore.exists(/databases/(default)/documents/organizations/$(organizationId));
    }

    function existsOrganization(organizationId) {
      return isVerifiedActiveUser()
        && organizationExists(organizationId);
    }

    function organizationData(organizationId) {
      return firestore.get(/databases/(default)/documents/organizations/$(organizationId)).data;
    }

    function isOrganizationOwner(organizationId) {
      return existsOrganization(organizationId)
        && ('ownerId' in organizationData(organizationId))
        && organizationData(organizationId).ownerId == request.auth.uid;
    }

    function isOrganizationAdmin(organizationId) {
      return existsOrganization(organizationId)
        && ('adminIds' in organizationData(organizationId))
        && organizationData(organizationId).adminIds.hasAny([request.auth.uid]);
    }

    function isOrganizationModerator(organizationId) {
      return existsOrganization(organizationId)
        && ('moderatorIds' in organizationData(organizationId))
        && organizationData(organizationId).moderatorIds.hasAny([request.auth.uid]);
    }

    function isOrganizationRequestCreator(organizationId) {
      return isVerifiedActiveUser()
        && organizationExists(organizationId)
        && organizationData(organizationId).get('submittedByUserId', '') == request.auth.uid
        && organizationData(organizationId).get('moderationStatus', '')
          in ['pendingReview', 'needsRevision', 'rejected'];
    }

    function canEditOrganizationContent(organizationId) {
      return isVerifiedActiveUser()
        && organizationExists(organizationId)
        && (
          currentUserData().get('globalRole', 'user') == 'owner'
          || organizationData(organizationId).get('ownerId', '') == request.auth.uid
          || organizationData(organizationId).get('adminIds', []).hasAny([request.auth.uid])
          || organizationData(organizationId).get('moderatorIds', []).hasAny([request.auth.uid])
        );
    }

    function canManageOrganizationPhotos(organizationId) {
      return canEditOrganizationContent(organizationId);
    }

    function canReadOrganizationMedia(organizationId) {
      return organizationExists(organizationId)
        && (
          organizationData(organizationId).moderationStatus == 'approved'
          || isOrganizationRequestCreator(organizationId)
          || canEditOrganizationContent(organizationId)
        );
    }

    function isSafeImageUpload() {
      return request.resource != null
        && request.resource.size < 3 * 1024 * 1024
        && request.resource.contentType == 'image/jpeg';
    }

    function isSafeFeaturedBannerImageUpload() {
      return request.resource != null
        && request.resource.size < 5 * 1024 * 1024
        && request.resource.contentType == 'image/jpeg';
    }

    function canManageNewsCover(newsId) {
      return firestore.exists(/databases/(default)/documents/news/$(newsId))
        && firestore.get(/databases/(default)/documents/news/$(newsId)).data.sourceType == 'organization'
        && canEditOrganizationContent(
          firestore.get(/databases/(default)/documents/news/$(newsId)).data.organizationId
        );
    }

    function canReadNewsCover(newsId) {
      return firestore.exists(/databases/(default)/documents/news/$(newsId))
        && (
          firestore.get(/databases/(default)/documents/news/$(newsId)).data.moderationStatus == 'approved'
          || canModerateSection('news')
          || canManageNewsCover(newsId)
        );
    }

    function canManageEventCover(eventId) {
      return firestore.exists(/databases/(default)/documents/events/$(eventId))
        && firestore.get(/databases/(default)/documents/events/$(eventId)).data.sourceType == 'organization'
        && canEditOrganizationContent(
          firestore.get(/databases/(default)/documents/events/$(eventId)).data.organizationId
        );
    }

    function canReadEventCover(eventId) {
      return firestore.exists(/databases/(default)/documents/events/$(eventId))
        && (
          firestore.get(/databases/(default)/documents/events/$(eventId)).data.moderationStatus == 'approved'
          || canModerateSection('events')
          || canManageEventCover(eventId)
        );
    }

    function legacyCoverBelongsToOrganization(organizationId, collection, contentId) {
      let path = /databases/(default)/documents/$(collection)/$(contentId);
      return firestore.exists(path)
        && firestore.get(path).data.sourceType == 'organization'
        && firestore.get(path).data.organizationId == organizationId;
    }

    match /news/{newsId}/cover.jpg {
      allow read: if canReadNewsCover(newsId);
      allow create, update: if (canManageContentImages('news') || canManageNewsCover(newsId))
        && isSafeImageUpload();
      allow delete: if false;
    }

    match /news/{filePath=**} {
      allow read: if false;
      allow write: if false;
    }

    match /events/{eventId}/cover.jpg {
      allow read: if canReadEventCover(eventId);
      allow create, update: if canManageEventCover(eventId)
        && isSafeImageUpload();
      allow delete: if false;
    }

    match /events/{filePath=**} {
      allow read: if false;
      allow write: if false;
    }

    match /organizations/{organizationId}/logo.jpg {
      allow read: if canReadOrganizationMedia(organizationId);
      allow create, update: if (
          isOrganizationRequestCreator(organizationId)
          || canEditOrganizationContent(organizationId)
        )
        && isSafeImageUpload();
      allow delete: if isOrganizationRequestCreator(organizationId)
        || canEditOrganizationContent(organizationId);
    }

    match /organizations/{organizationId}/cover.jpg {
      allow read: if canReadOrganizationMedia(organizationId);
      allow create, update: if false;
      allow delete: if isOrganizationRequestCreator(organizationId)
        || canEditOrganizationContent(organizationId);
    }

    match /organizations/{organizationId}/photos/{fileName} {
      allow read: if fileName.matches('^.+\\.jpg$')
        && canReadOrganizationMedia(organizationId);
      // Storage CREATE includes replacement file contents; UPDATE is metadata-only.
      allow create: if resource == null
        && canManageOrganizationPhotos(organizationId)
        && fileName.matches('^.+\\.jpg$')
        && isSafeImageUpload();
      allow delete: if canManageOrganizationPhotos(organizationId)
        && fileName.matches('^.+\\.jpg$');
    }

    match /organizations/{organizationId}/photoVersions/{fileName} {
      // New photo commands publish immutable versioned JPEGs via the backend.
      allow read: if fileName.matches('^[a-f0-9]{64}\\.jpg$')
        && canReadOrganizationMedia(organizationId);
      allow write: if false;
    }

    // Existing content still references these immutable legacy PNG covers.
    // Tie access to the matching content document instead of every org object.
    match /organizations/{organizationId}/news/{newsId}/cover.png {
      allow read: if legacyCoverBelongsToOrganization(organizationId, 'news', newsId)
        && canReadNewsCover(newsId);
      allow write: if false;
    }

    match /organizations/{organizationId}/events/{eventId}/cover.png {
      allow read: if legacyCoverBelongsToOrganization(organizationId, 'events', eventId)
        && canReadEventCover(eventId);
      allow write: if false;
    }

    match /organizations/{organizationId}/draftUploads/news/{fileName} {
      allow read: if canEditOrganizationContent(organizationId);
      allow write: if false;
    }

    match /organizations/{organizationId}/draftUploads/events/{fileName} {
      allow read: if canEditOrganizationContent(organizationId);
      allow write: if false;
    }

    match /profileImages/{uid}/avatar.jpg {
      allow read: if true;
      allow create, update: if (
          (isSelf(uid) && isVerifiedActiveUser())
          || isOwner()
        )
        && isSafeImageUpload();
      allow delete: if (isSelf(uid) && isVerifiedActiveUser()) || isOwner();
    }

    match /featuredBanners/{bannerId}/{fileName} {
      allow read: if fileName.matches('^hero(-[A-Za-z0-9-]+)?\\.jpg$');
      allow create, update: if isOwner()
        && fileName.matches('^hero(-[A-Za-z0-9-]+)?\\.jpg$')
        && isSafeFeaturedBannerImageUpload();
      allow delete: if isOwner()
        && fileName.matches('^hero(-[A-Za-z0-9-]+)?\\.jpg$');
    }

    match /{allPaths=**} {
      allow read, write: if false;
    }
  }
}
