rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    function isSignedIn() {
      return request.auth != null;
    }

    function existsUser(uid) {
      return exists(/databases/$(database)/documents/users/$(uid));
    }

    function userDoc(uid) {
      return get(/databases/$(database)/documents/users/$(uid));
    }

    function userData(uid) {
      return userDoc(uid).data;
    }

    function currentUserData() {
      return userData(request.auth.uid);
    }

    function isSelf(uid) {
      return isSignedIn() && request.auth.uid == uid;
    }

    function isActiveUser() {
      return isSignedIn()
        && existsUser(request.auth.uid)
        && (
          !('accountStatus' in currentUserData())
          || currentUserData().accountStatus == 'active'
          || currentUserData().accountStatus == 'warned'
        )
        && (
          !('blockState' in currentUserData())
          || currentUserData().blockState == 'active'
          || currentUserData().blockState == 'warned'
        );
    }

    function isVerifiedEmailUser() {
      return isSignedIn() && request.auth.token.email_verified == true;
    }

    function isVerifiedActiveUser() {
      return isVerifiedEmailUser() && isActiveUser();
    }

    function isAppOwner() {
      return isVerifiedActiveUser()
        && ('globalRole' in currentUserData())
        && currentUserData().globalRole == 'owner';
    }

    function isAppAdmin() {
      return isVerifiedActiveUser()
        && ('globalRole' in currentUserData())
        && currentUserData().globalRole == 'admin';
    }

    function isPlatformManagementTier() {
      return isAppOwner() || isAppAdmin();
    }

    function canManageFeedback() {
      return isPlatformManagementTier();
    }

    function canManageOrganizationRequests() {
      return isAppOwner() || isAppAdmin();
    }

    function canManageUsers() {
      return isAppOwner() || isAppAdmin();
    }

    function canManageFeaturedBanners() {
      return isAppOwner();
    }

    function canUseOrganizationOverride() {
      return isAppOwner();
    }

    function systemLogAllowedFields() {
      return [
        'id',
        'createdAt',
        'category',
        'severity',
        'severityRank',
        'eventType',
        'actorUserId',
        'actorDisplayName',
        'actorRole',
        'targetType',
        'targetId',
        'targetTitle',
        'organizationId',
        'organizationName',
        'outcome',
        'summary',
        'technicalMessage',
        'errorCode',
        'moduleName',
        'screenName',
        'operationName',
        'appVersion',
        'osVersion',
        'deviceModel',
        'isReviewed',
        'reviewedAt',
        'reviewedByUserId',
        'metadata',
        'retentionPolicy',
        'correlationId',
        'isAppAdminReadable'
      ];
    }

    function appAdminReadableSystemLogCategories() {
      return ['userAccount', 'organization', 'moderation', 'diagnostics'];
    }

    function isSystemLogSecuritySensitive(data) {
      return (('retentionPolicy' in data) && data.retentionPolicy == 'security')
        || (('category' in data) && data.category == 'authorization')
        || (('eventType' in data) && data.eventType in ['permissionDenied', 'accountBlocked']);
    }

    function isSystemLogOwnerActor(data) {
      return ('actorRole' in data) && data.actorRole == 'owner';
    }

    function isSystemLogOwnerTarget(data) {
      return ((('targetActorRole' in data) && data.targetActorRole == 'owner')
        || (('targetRole' in data) && data.targetRole == 'owner'));
    }

    function canAppAdminReadSystemLog(data) {
      return isAppAdmin()
        && ('isAppAdminReadable' in data)
        && data.isAppAdminReadable == true;
    }

    function expectedSystemLogAppAdminReadable(data) {
      return ('category' in data)
        && data.category in appAdminReadableSystemLogCategories()
        && !isSystemLogSecuritySensitive(data)
        && !isSystemLogOwnerActor(data)
        && !isSystemLogOwnerTarget(data);
    }

    function canReadSystemLog(data) {
      return isAppOwner() || canAppAdminReadSystemLog(data);
    }

    function isOwnerOrAppAdmin() {
      return isVerifiedActiveUser()
        && ('globalRole' in currentUserData())
        && currentUserData().globalRole in ['owner', 'admin'];
    }

    function isModerationLogActor() {
      return isVerifiedActiveUser()
        && ('globalRole' in currentUserData())
        && currentUserData().globalRole in ['owner', 'admin'];
    }

    function requestActorMatchesAuth() {
      return request.resource.data.actorUserId == request.auth.uid
        && request.resource.data.actorRole in ['owner', 'admin']
        && request.resource.data.actorRole == currentUserData().globalRole;
    }

    function requestModerationActorMatchesAuth() {
      return request.resource.data.actorUserId == request.auth.uid
        && request.resource.data.actorRole in ['owner', 'admin']
        && request.resource.data.actorRole == currentUserData().globalRole;
    }

    function validSystemLogCreateBase(logId) {
      return request.resource.data.keys().hasOnly(systemLogAllowedFields())
        && request.resource.data.id == logId
        && request.resource.data.createdAt is timestamp
        && request.resource.data.createdAt == request.time
        && request.resource.data.severityRank is int
        && request.resource.data.targetType is string
        && request.resource.data.summary is string
        && request.resource.data.summary.size() > 0
        && request.resource.data.summary.size() <= 512
        && request.resource.data.isAppAdminReadable is bool
        && request.resource.data.isAppAdminReadable == expectedSystemLogAppAdminReadable(request.resource.data)
        && request.resource.data.isReviewed == false
        && !('reviewedAt' in request.resource.data)
        && !('reviewedByUserId' in request.resource.data)
        && (!('metadata' in request.resource.data) || request.resource.data.metadata is map)
        && !isSystemLogSecuritySensitive(request.resource.data)
        && !isSystemLogOwnerTarget(request.resource.data);
    }

    function isSafeDiagnosticsCreate(logId) {
      return validSystemLogCreateBase(logId)
        && request.resource.data.category == 'diagnostics'
        && request.resource.data.retentionPolicy == 'technicalError'
        && request.resource.data.eventType is string
        && request.resource.data.severity in ['debug', 'info', 'notice', 'warning', 'error', 'critical']
        && request.resource.data.actorRole is string
        && (!('technicalMessage' in request.resource.data) || request.resource.data.technicalMessage is string);
    }

    function isSafeAuditCreate(logId) {
      return validSystemLogCreateBase(logId)
        && request.resource.data.category == 'audit'
        && request.resource.data.retentionPolicy == 'normalAudit'
        && request.resource.data.eventType in ['contentCreated', 'contentUpdated', 'contentDeleted']
        && request.resource.data.severity == 'info'
        && request.resource.data.outcome == 'success'
        && requestActorMatchesAuth()
        && request.resource.data.targetType in ['newsPost', 'event', 'organization', 'systemConfiguration']
        && request.resource.data.moduleName is string
        && request.resource.data.operationName is string
        && (!('targetId' in request.resource.data) || request.resource.data.targetId is string)
        && (!('targetTitle' in request.resource.data) || request.resource.data.targetTitle is string)
        && (!('organizationId' in request.resource.data) || request.resource.data.organizationId is string)
        && (!('organizationName' in request.resource.data) || request.resource.data.organizationName is string)
        && !('technicalMessage' in request.resource.data)
        && !('errorCode' in request.resource.data);
    }

    function isSafeModerationCreate(logId) {
      return validSystemLogCreateBase(logId)
        && request.resource.data.category == 'moderation'
        && request.resource.data.retentionPolicy == 'moderationDispute'
        && request.resource.data.eventType in [
          'contentApproved',
          'contentRejected',
          'organizationRequestApproved',
          'organizationRequestRejected',
          'reportReviewed'
        ]
        && request.resource.data.severity in ['info', 'notice']
        && request.resource.data.outcome in ['approved', 'rejected', 'success']
        && requestModerationActorMatchesAuth()
        && request.resource.data.targetType in [
          'newsPost',
          'event',
          'organization',
          'organizationRequest',
          'report'
        ]
        && request.resource.data.moduleName == 'Moderation'
        && request.resource.data.operationName is string
        && (!('targetId' in request.resource.data) || request.resource.data.targetId is string)
        && (!('targetTitle' in request.resource.data) || request.resource.data.targetTitle is string)
        && (!('organizationId' in request.resource.data) || request.resource.data.organizationId is string)
        && (!('organizationName' in request.resource.data) || request.resource.data.organizationName is string)
        && !('technicalMessage' in request.resource.data)
        && !('errorCode' in request.resource.data);
    }

    function validSystemLogSecurityCreateBase(logId) {
      return request.resource.data.keys().hasOnly(systemLogAllowedFields())
        && request.resource.data.id == logId
        && request.resource.data.createdAt is timestamp
        && request.resource.data.createdAt == request.time
        && request.resource.data.severityRank is int
        && request.resource.data.targetType is string
        && request.resource.data.summary is string
        && request.resource.data.summary.size() > 0
        && request.resource.data.summary.size() <= 512
        && request.resource.data.isAppAdminReadable is bool
        && request.resource.data.isAppAdminReadable == expectedSystemLogAppAdminReadable(request.resource.data)
        && request.resource.data.isReviewed == false
        && !('reviewedAt' in request.resource.data)
        && !('reviewedByUserId' in request.resource.data)
        && (!('metadata' in request.resource.data) || request.resource.data.metadata is map)
        && !isSystemLogOwnerTarget(request.resource.data);
    }

    function isSafeSecurityCreate(logId) {
      return validSystemLogSecurityCreateBase(logId)
        && request.resource.data.category == 'authorization'
        && request.resource.data.retentionPolicy == 'security'
        && request.resource.data.eventType in [
          'permissionDenied',
          'roleAssigned',
          'roleRemoved',
          'accountBlocked',
          'accountUnblocked',
          'userWarned'
        ]
        && request.resource.data.severity in ['notice', 'warning', 'error']
        && request.resource.data.outcome in ['success', 'failed', 'blocked']
        && requestActorMatchesAuth()
        && request.resource.data.targetType in ['userProfile', 'organization']
        && request.resource.data.moduleName in ['Security', 'Account']
        && request.resource.data.operationName is string
        && (!('targetId' in request.resource.data) || request.resource.data.targetId is string)
        && (!('targetTitle' in request.resource.data) || request.resource.data.targetTitle is string)
        && !('organizationId' in request.resource.data)
        && !('organizationName' in request.resource.data)
        && !('technicalMessage' in request.resource.data)
        && !('errorCode' in request.resource.data);
    }

    function canCreateDiagnosticsLog(logId) {
      return isOwnerOrAppAdmin()
        && isSafeDiagnosticsCreate(logId);
    }

    function canCreateAuditLog(logId) {
      return isOwnerOrAppAdmin()
        && isSafeAuditCreate(logId);
    }

    function canCreateModerationLog(logId) {
      return isModerationLogActor()
        && isSafeModerationCreate(logId);
    }

    function canCreateSecurityLog(logId) {
      return isOwnerOrAppAdmin()
        && isSafeSecurityCreate(logId);
    }

    function validSystemLogClientCreate(logId) {
      return request.resource.data.category == 'diagnostics'
        ? canCreateDiagnosticsLog(logId)
        : request.resource.data.category == 'audit'
          ? canCreateAuditLog(logId)
          : request.resource.data.category == 'moderation'
            ? canCreateModerationLog(logId)
            : request.resource.data.category == 'authorization'
              ? canCreateSecurityLog(logId)
              : false;
    }

    function validSystemLogReviewUpdate() {
      return request.resource.data.diff(resource.data).affectedKeys().hasOnly([
          'isReviewed',
          'reviewedAt',
          'reviewedByUserId'
        ])
        && request.resource.data.isReviewed == true
        && request.resource.data.reviewedAt is timestamp
        && request.resource.data.reviewedByUserId == request.auth.uid
        && (
          isAppOwner()
          || (canAppAdminReadSystemLog(resource.data) && canAppAdminReadSystemLog(request.resource.data))
        );
    }

    function isOwner() {
      return isAppOwner();
    }

    function canModerateSection(section) {
      // Legacy role fields and moderatorSections are migration-only and are
      // not active authorization sources.
      return section is string && isPlatformManagementTier();
    }

    function isApprovedContent() {
      return resource.data.moderationStatus == 'approved';
    }

    function canReadOwnScheduledDraft(data) {
      return isVerifiedActiveUser()
        && data.moderationStatus == 'draft'
        && ('authorId' in data)
        && data.authorId == request.auth.uid;
    }

    function hasValidPublicationSchedule(data) {
      return (
          data.moderationStatus == 'draft'
          && ('scheduledAt' in data)
          && data.scheduledAt is timestamp
          && data.scheduledAt > request.time
        ) || (
          data.moderationStatus != 'draft'
          && !('scheduledAt' in data)
        );
    }

    function newsDocumentFields() {
      return [
        'id', 'title', 'subtitle', 'summary', 'regionScope', 'federalState',
        'city', 'category', 'additionalCategories', 'tags', 'sourceType', 'organizationId',
        'organizationName', 'organizationImageURL', 'sourceName', 'sourceURL',
        'imageURL', 'body', 'authorId', 'authorName', 'publishedAt', 'createdAt',
        'updatedAt', 'moderationStatus', 'likeCount', 'likeState', 'viewCount',
        'commentCount', 'schemaVersion', 'localizations', 'mediaMetadata',
        'externalAction', 'scheduledAt'
      ];
    }

    function eventDocumentFields() {
      return [
        'id', 'title', 'summary', 'details', 'regionScope', 'federalState',
        'sourceType', 'organizationId', 'organizationName',
        'organizationImageURL', 'authorId', 'authorName', 'city', 'venue',
        'address', 'locationNote', 'latitude', 'longitude', 'organizerName',
        'organizerURL', 'contactPhone', 'contactEmail', 'contactURL', 'imageURL',
        'startDate', 'endDate', 'createdAt', 'updatedAt', 'requiresRegistration',
        'price', 'capacity', 'registeredCount', 'moderationStatus',
        'registrationState', 'likeCount', 'likeState', 'viewCount',
        'commentCount', 'category', 'additionalCategories', 'audience', 'minimumAge', 'maximumAge',
        'tags', 'visibility', 'isAllDay', 'cancellationState', 'cancelledAt',
        'cancellationReason', 'schemaVersion', 'localizations', 'occurrences',
        'participationMode', 'externalAction', 'pricing', 'scheduledAt'
      ];
    }

    function commentDocumentFields() {
      return [
        'id', 'parentType', 'parentId', 'authorId', 'authorName',
        'authorPhotoURL', 'text', 'body', 'createdAt', 'updatedAt',
        'moderationStatus', 'isDeleted'
      ];
    }

    function validOptionalString(data, field, maximumLength) {
      return !(field in data)
        || data[field] == null
        || (data[field] is string && data[field].size() <= maximumLength);
    }

    function validContentRegion(data) {
      return (!('regionScope' in data) || data.regionScope in ['austria', 'federalState', 'city'])
        && validOptionalString(data, 'federalState', 64)
        && validOptionalString(data, 'city', 160);
    }

    function validNewsDocument(data, newsId) {
      return data.keys().hasOnly(newsDocumentFields())
        && data.keys().hasAll([
          'id', 'title', 'subtitle', 'body', 'sourceType',
          'authorName', 'publishedAt', 'createdAt', 'updatedAt',
          'moderationStatus', 'likeCount', 'likeState', 'viewCount', 'commentCount'
        ])
        && data.id == newsId
        && data.title is string && data.title.size() > 0 && data.title.size() <= 180
        && data.subtitle is string && data.subtitle.size() <= 500
        && data.body is string && data.body.size() > 0 && data.body.size() <= 50000
        && data.sourceType in ['organization', 'app']
        && (
          (data.sourceType == 'organization'
            && data.organizationId is string
            && data.organizationId.size() > 0)
          || (data.sourceType == 'app' && !('organizationId' in data))
        )
        && (!('authorId' in data)
          || (data.authorId is string && data.authorId.size() > 0 && data.authorId.size() <= 128))
        && data.authorName is string && data.authorName.size() <= 160
        && data.publishedAt is timestamp
        && data.createdAt is timestamp
        && data.updatedAt is timestamp
        && data.moderationStatus in ['draft', 'pendingReview', 'approved', 'rejected', 'archived']
        && (!('scheduledAt' in data) || data.scheduledAt is timestamp)
        && data.likeCount is int && data.likeCount >= 0
        && data.viewCount is int && data.viewCount >= 0
        && data.commentCount is int && data.commentCount >= 0
        && data.likeState is string
        && (!('tags' in data) || (data.tags is list && data.tags.size() <= 12))
        && (!('additionalCategories' in data)
          || (data.additionalCategories is list
            && data.additionalCategories.size() <= 2
            && data.additionalCategories.hasOnly([
              'news', 'event', 'lawAndDocuments', 'benefitsAndSupport', 'health',
              'work', 'education', 'housing', 'transport',
              'communityAndIntegration', 'culture', 'other'
            ])
            && (!('category' in data) || !(data.category in data.additionalCategories))))
        && validOptionalString(data, 'imageURL', 2048)
        && validOptionalString(data, 'sourceURL', 2048)
        && validContentRegion(data);
    }

    function validEventDocument(data, eventId) {
      return data.keys().hasOnly(eventDocumentFields())
        && data.keys().hasAll([
          'id', 'title', 'summary', 'details', 'sourceType',
          'city', 'venue', 'startDate', 'endDate', 'createdAt', 'updatedAt',
          'price', 'registeredCount', 'moderationStatus',
          'registrationState', 'likeCount', 'likeState', 'viewCount',
          'commentCount', 'visibility', 'isAllDay'
        ])
        && data.id == eventId
        && data.title is string && data.title.size() > 0 && data.title.size() <= 180
        && data.summary is string && data.summary.size() <= 500
        && data.details is string && data.details.size() > 0 && data.details.size() <= 50000
        && data.sourceType in ['organization', 'app']
        && (
          (data.sourceType == 'organization'
            && data.organizationId is string
            && data.organizationId.size() > 0)
          || (data.sourceType == 'app' && !('organizationId' in data))
        )
        && data.city is string && data.city.size() <= 160
        && data.venue is string && data.venue.size() <= 240
        && data.startDate is timestamp && data.endDate is timestamp
        && data.endDate >= data.startDate
        && data.createdAt is timestamp && data.updatedAt is timestamp
        && (!('requiresRegistration' in data) || data.requiresRegistration is bool)
        && data.price is number && data.price >= 0
        && data.registeredCount is int && data.registeredCount >= 0
        && data.moderationStatus in ['draft', 'pendingReview', 'approved', 'rejected', 'archived']
        && (!('scheduledAt' in data) || data.scheduledAt is timestamp)
        && data.registrationState is string
        && data.likeCount is int && data.likeCount >= 0
        && data.viewCount is int && data.viewCount >= 0
        && data.commentCount is int && data.commentCount >= 0
        && data.likeState is string
        && data.visibility == 'public'
        && data.isAllDay is bool
        && (!('capacity' in data) || (data.capacity is int && data.capacity > 0))
        && (!('minimumAge' in data) || (data.minimumAge is int && data.minimumAge >= 0 && data.minimumAge <= 120))
        && (!('maximumAge' in data) || (data.maximumAge is int && data.maximumAge >= 0 && data.maximumAge <= 120))
        && (!('minimumAge' in data) || !('maximumAge' in data) || data.minimumAge <= data.maximumAge)
        && (!('tags' in data) || (data.tags is list && data.tags.size() <= 12))
        && (!('additionalCategories' in data)
          || (data.additionalCategories is list
            && data.additionalCategories.size() <= 2
            && data.additionalCategories.hasOnly([
              'meetups', 'training', 'culture', 'education', 'childrenAndFamily',
              'sportsAndWellness', 'music', 'foodAndMarket', 'businessAndNetworking',
              'volunteering', 'supportAndIntegration', 'celebration',
              'saleAndPromotion', 'other'
            ])
            && (!('category' in data) || !(data.category in data.additionalCategories))))
        && validOptionalString(data, 'imageURL', 2048)
        && validContentRegion(data);
    }

    function validCommentCreate(parentType, parentId, commentId) {
      return request.resource.data.keys().hasOnly(commentDocumentFields())
        && request.resource.data.id == commentId
        && request.resource.data.parentType == parentType
        && request.resource.data.parentId == parentId
        && request.resource.data.authorId == request.auth.uid
        && request.resource.data.authorName is string
        && request.resource.data.authorName.size() <= 160
        && validOptionalString(request.resource.data, 'authorPhotoURL', 2048)
        && request.resource.data.text is string
        && request.resource.data.text.size() > 0
        && request.resource.data.text.size() <= 1000
        && request.resource.data.body == request.resource.data.text
        && request.resource.data.createdAt is timestamp
        && request.resource.data.isDeleted == false
        && (!('moderationStatus' in request.resource.data)
          || request.resource.data.moderationStatus == 'approved');
    }

    function userSelfEditableFields() {
      return ['fullName', 'displayName', 'telegramUsername', 'city', 'bio', 'email', 'selectedFederalState', 'avatarURL', 'updatedAt'];
    }

    function isLegalDocumentType(documentType) {
      return documentType in ['terms', 'privacy', 'organizationRules'];
    }

    function legalDocumentPointerFields() {
      return [
        'documentType',
        'activeVersion',
        'versionNumber',
        'status',
        'requiresAcceptance',
        'defaultLocale',
        'updatedAt',
        'updatedBy',
        'publishedAt',
        'publishedBy',
        'changeSummary'
      ];
    }

    function legalDocumentVersionFields() {
      return [
        'documentType',
        'version',
        'versionNumber',
        'status',
        'requiresAcceptance',
        'defaultLocale',
        'canonicalLocale',
        'locales',
        'contentHash',
        'changeSummary',
        'createdAt',
        'createdBy',
        'updatedAt',
        'updatedBy',
        'publishedAt',
        'publishedBy',
        'supersedesVersion'
      ];
    }

    function validLegalDocumentPointer(documentType) {
      return isLegalDocumentType(documentType)
        && request.resource.data.keys().hasOnly(legalDocumentPointerFields())
        && request.resource.data.documentType == documentType
        && request.resource.data.activeVersion is string
        && request.resource.data.versionNumber is int
        && request.resource.data.status in ['draft', 'published']
        && request.resource.data.requiresAcceptance is bool
        && request.resource.data.defaultLocale is string
        && request.resource.data.updatedAt is timestamp
        && request.resource.data.updatedBy == request.auth.uid
        && (!('publishedAt' in request.resource.data)
          || request.resource.data.publishedAt == null
          || request.resource.data.publishedAt is timestamp)
        && (!('publishedBy' in request.resource.data)
          || request.resource.data.publishedBy == null
          || request.resource.data.publishedBy == request.auth.uid)
        && (!('changeSummary' in request.resource.data)
          || request.resource.data.changeSummary == null
          || request.resource.data.changeSummary is string);
    }

    function validLegalDocumentVersion(documentType, version) {
      return isLegalDocumentType(documentType)
        && request.resource.data.keys().hasOnly(legalDocumentVersionFields())
        && request.resource.data.documentType == documentType
        && request.resource.data.version == version
        && request.resource.data.version is string
        && request.resource.data.versionNumber is int
        && request.resource.data.status in ['draft', 'published', 'archived']
        && request.resource.data.requiresAcceptance is bool
        && request.resource.data.defaultLocale is string
        && request.resource.data.canonicalLocale is string
        && request.resource.data.locales is map
        && request.resource.data.locales.keys().size() > 0
        && request.resource.data.locales[request.resource.data.defaultLocale] is map
        && request.resource.data.locales[request.resource.data.defaultLocale].title is string
        && request.resource.data.locales[request.resource.data.defaultLocale].contentMarkdown is string
        && (!('contentText' in request.resource.data.locales[request.resource.data.defaultLocale])
          || request.resource.data.locales[request.resource.data.defaultLocale].contentText == null
          || request.resource.data.locales[request.resource.data.defaultLocale].contentText is string)
        && (!('contentHash' in request.resource.data.locales[request.resource.data.defaultLocale])
          || request.resource.data.locales[request.resource.data.defaultLocale].contentHash == null
          || request.resource.data.locales[request.resource.data.defaultLocale].contentHash is string)
        && request.resource.data.locales[request.resource.data.canonicalLocale] is map
        && request.resource.data.locales[request.resource.data.canonicalLocale].title is string
        && request.resource.data.locales[request.resource.data.canonicalLocale].contentMarkdown is string
        && (!('contentText' in request.resource.data.locales[request.resource.data.canonicalLocale])
          || request.resource.data.locales[request.resource.data.canonicalLocale].contentText == null
          || request.resource.data.locales[request.resource.data.canonicalLocale].contentText is string)
        && (!('contentHash' in request.resource.data.locales[request.resource.data.canonicalLocale])
          || request.resource.data.locales[request.resource.data.canonicalLocale].contentHash == null
          || request.resource.data.locales[request.resource.data.canonicalLocale].contentHash is string)
        && request.resource.data.contentHash is string
        && request.resource.data.createdAt is timestamp
        && request.resource.data.createdBy == request.auth.uid
        && request.resource.data.updatedAt is timestamp
        && request.resource.data.updatedBy == request.auth.uid
        && (!('publishedAt' in request.resource.data)
          || request.resource.data.publishedAt == null
          || request.resource.data.publishedAt is timestamp)
        && (!('publishedBy' in request.resource.data)
          || request.resource.data.publishedBy == null
          || request.resource.data.publishedBy == request.auth.uid)
        && (!('changeSummary' in request.resource.data)
          || request.resource.data.changeSummary == null
          || request.resource.data.changeSummary is string)
        && (!('supersedesVersion' in request.resource.data)
          || request.resource.data.supersedesVersion == null
          || request.resource.data.supersedesVersion is string);
    }

    function userSelfDeletionFields() {
      return [
        'accountStatus',
        'blockState',
        'isBlocked',
        'displayName',
        'fullName',
        'bio',
        'city',
        'email',
        'telegramUsername',
        'avatarURL',
        'updatedAt'
      ];
    }

    function recentViewFields() {
      return ['itemId', 'itemType', 'title', 'subtitle', 'imageURL', 'viewedAt'];
    }

    function activityLogFields() {
      return ['id', 'actionType', 'targetId', 'targetType', 'title', 'subtitle', 'imageURL', 'createdAt'];
    }

    function notificationPushTokenFields() {
      return [
        'id',
        'token',
        'registrationType',
        'platform',
        'deviceName',
        'appVersion',
        'createdAt',
        'updatedAt'
      ];
    }

    function validNotificationPushTokenWrite(uid, tokenId) {
      return isVerifiedActiveUser()
        && request.auth.uid == uid
        && request.resource.data.keys().hasOnly(notificationPushTokenFields())
        && request.resource.data.id == tokenId
        && request.resource.data.token is string
        && request.resource.data.token.size() > 0
        && request.resource.data.token.size() <= 4096
        // Missing type is the legacy schema used by supported older clients.
        && (!('registrationType' in request.resource.data)
          || request.resource.data.registrationType == 'token'
          || (request.resource.data.registrationType == 'fid'
            && request.resource.data.token.matches('^[A-Za-z0-9_-]{22}$')))
        && request.resource.data.platform == 'ios'
        && (!('deviceName' in request.resource.data) || request.resource.data.deviceName is string)
        && (!('appVersion' in request.resource.data) || request.resource.data.appVersion is string)
        && request.resource.data.updatedAt is timestamp
        && (!('createdAt' in request.resource.data) || request.resource.data.createdAt is timestamp);
    }

    function feedbackCreateFields() {
      return [
        'id',
        'userId',
        'userDisplayName',
        'type',
        'subject',
        'message',
        'status',
        'createdAt',
        'updatedAt',
        'lastMessageText',
        'lastMessageAt',
        'lastMessageByUserId',
        'lastMessageByRole',
        'unreadForOwner',
        'unreadForUser'
      ];
    }

    function feedbackOwnerUpdateFields() {
      return [
        'ownerReply',
        'repliedAt',
        'repliedByUserId',
        'status',
        'updatedAt',
        'lastMessageText',
        'lastMessageAt',
        'lastMessageByUserId',
        'lastMessageByRole',
        'unreadForOwner',
        'unreadForUser'
      ];
    }

    function feedbackUserReplyUpdateFields() {
      return [
        'status',
        'updatedAt',
        'lastMessageText',
        'lastMessageAt',
        'lastMessageByUserId',
        'lastMessageByRole',
        'unreadForOwner',
        'unreadForUser'
      ];
    }

    function feedbackChangedKeys() {
      return request.resource.data.diff(resource.data).affectedKeys();
    }

    function feedbackMessageFields() {
      return ['id', 'feedbackId', 'senderId', 'senderDisplayName', 'senderRole', 'text', 'createdAt', 'isSystem'];
    }

    function safeFeedbackCreate(feedbackId) {
      return isVerifiedActiveUser()
        && request.resource.data.keys().hasOnly(feedbackCreateFields())
        && request.resource.data.id == feedbackId
        && request.resource.data.userId == request.auth.uid
        && request.resource.data.userDisplayName is string
        && request.resource.data.type in ['question', 'suggestion', 'bug', 'report']
        && (!('subject' in request.resource.data) || request.resource.data.subject is string)
        && request.resource.data.message is string
        && request.resource.data.message.size() > 0
        && request.resource.data.message.size() <= 2000
        && request.resource.data.status == 'open'
        && request.resource.data.createdAt is timestamp
        && request.resource.data.updatedAt is timestamp
        && request.resource.data.lastMessageText == request.resource.data.message
        && request.resource.data.lastMessageAt is timestamp
        && request.resource.data.lastMessageByUserId == request.auth.uid
        && request.resource.data.lastMessageByRole == 'user'
        && request.resource.data.unreadForOwner == true
        && request.resource.data.unreadForUser == false;
    }

    function safeFeedbackOwnerUpdate() {
      return canManageFeedback()
        && (!('dsaCase' in resource.data) || request.resource.data.status != 'closed')
        && feedbackChangedKeys().hasOnly(feedbackOwnerUpdateFields())
        && request.resource.data.status in ['open', 'answered', 'closed', 'reviewed', 'archived']
        && request.resource.data.updatedAt is timestamp
        && (!feedbackChangedKeys().hasAny(['lastMessageText']) || request.resource.data.lastMessageText is string)
        && (!feedbackChangedKeys().hasAny(['lastMessageAt']) || request.resource.data.lastMessageAt is timestamp)
        && (!feedbackChangedKeys().hasAny(['lastMessageByUserId']) || request.resource.data.lastMessageByUserId == request.auth.uid)
        && (!feedbackChangedKeys().hasAny(['lastMessageByRole']) || request.resource.data.lastMessageByRole == 'owner')
        && (!feedbackChangedKeys().hasAny(['unreadForOwner']) || request.resource.data.unreadForOwner is bool)
        && (!feedbackChangedKeys().hasAny(['unreadForUser']) || request.resource.data.unreadForUser is bool)
        && (!feedbackChangedKeys().hasAny(['ownerReply'])
          || (request.resource.data.ownerReply is string
            && request.resource.data.ownerReply.size() > 0
            && request.resource.data.ownerReply.size() <= 2000))
        && (!feedbackChangedKeys().hasAny(['repliedAt']) || request.resource.data.repliedAt is timestamp)
        && (!feedbackChangedKeys().hasAny(['repliedByUserId']) || request.resource.data.repliedByUserId == request.auth.uid);
    }

    function safeFeedbackUserReplyUpdate() {
      return isVerifiedActiveUser()
        && resource.data.userId == request.auth.uid
        && resource.data.status != 'closed'
        && request.resource.data.diff(resource.data).affectedKeys().hasOnly(feedbackUserReplyUpdateFields())
        && request.resource.data.status == 'open'
        && request.resource.data.updatedAt is timestamp
        && request.resource.data.lastMessageText is string
        && request.resource.data.lastMessageText.size() > 0
        && request.resource.data.lastMessageText.size() <= 2000
        && request.resource.data.lastMessageAt is timestamp
        && request.resource.data.lastMessageByUserId == request.auth.uid
        && request.resource.data.lastMessageByRole == 'user'
        && request.resource.data.unreadForOwner == true
        && request.resource.data.unreadForUser == false;
    }

    function canReadFeedback(feedbackId) {
      return canManageFeedback()
        || (isSignedIn()
          && get(/databases/$(database)/documents/feedback/$(feedbackId)).data.userId == request.auth.uid);
    }

    function safeFeedbackMessageCreate(feedbackId, messageId) {
      let parent = get(/databases/$(database)/documents/feedback/$(feedbackId)).data;
      let parentAfter = getAfter(/databases/$(database)/documents/feedback/$(feedbackId)).data;
      let message = request.resource.data;
      return isVerifiedActiveUser()
        && parent.status != 'closed'
        && message.keys().hasOnly(feedbackMessageFields())
        && message.id == messageId
        && message.feedbackId == feedbackId
        && message.senderId == request.auth.uid
        && message.senderDisplayName is string
        && message.text is string
        && message.text.size() > 0
        && message.text.size() <= 2000
        && message.createdAt is timestamp
        && (!('isSystem' in message) || message.isSystem is bool)
        && parentAfter.diff(parent).affectedKeys().hasAny([
          'updatedAt',
          'lastMessageText',
          'lastMessageAt',
          'lastMessageByUserId',
          'lastMessageByRole',
          'unreadForOwner',
          'unreadForUser'
        ])
        && parentAfter.updatedAt == message.createdAt
        && parentAfter.lastMessageText == message.text
        && parentAfter.lastMessageAt == message.createdAt
        && parentAfter.lastMessageByUserId == request.auth.uid
        && parentAfter.lastMessageByRole == message.senderRole
        && (
          (parent.userId == request.auth.uid
            && message.senderRole == 'user'
            && (!('isSystem' in message) || message.isSystem == false)
            && parentAfter.status == 'open'
            && parentAfter.unreadForOwner == true
            && parentAfter.unreadForUser == false)
          || (canManageFeedback()
            && message.senderRole == 'owner'
            && parentAfter.status in ['answered', 'closed']
            && parentAfter.unreadForOwner == false
            && parentAfter.unreadForUser == true
            && (
              (message.isSystem == true && parentAfter.status == 'closed')
              || ((!('isSystem' in message) || message.isSystem == false)
                && parentAfter.status == 'answered'
                && parentAfter.ownerReply == message.text
                && parentAfter.repliedAt == message.createdAt
                && parentAfter.repliedByUserId == request.auth.uid)
            ))
        );
    }

    function safeRecentViewWrite(uid, recentViewId) {
      return isVerifiedActiveUser()
        && request.auth.uid == uid
        && request.resource.data.keys().hasOnly(recentViewFields())
        && request.resource.data.itemId is string
        && request.resource.data.itemType in ['news', 'event', 'organization']
        && request.resource.data.title is string
        && (!('subtitle' in request.resource.data) || request.resource.data.subtitle is string || request.resource.data.subtitle == null)
        && (!('imageURL' in request.resource.data) || request.resource.data.imageURL is string || request.resource.data.imageURL == null)
        && request.resource.data.viewedAt is timestamp
        && recentViewId == request.resource.data.itemType + '_' + request.resource.data.itemId;
    }

    function safeActivityLogWrite(uid, activityLogId) {
      return isVerifiedActiveUser()
        && request.auth.uid == uid
        && request.resource.data.keys().hasOnly(activityLogFields())
        && request.resource.data.id == activityLogId
        && request.resource.data.actionType in [
          'registeredForEvent',
          'canceledEventRegistration',
          'followedOrganization',
          'unfollowedOrganization',
          'savedNews',
          'unsavedNews',
          'savedEvent',
          'unsavedEvent',
          'savedOrganization',
          'unsavedOrganization'
        ]
        && request.resource.data.targetId is string
        && request.resource.data.targetType in ['news', 'event', 'organization']
        && request.resource.data.title is string
        && (!('subtitle' in request.resource.data) || request.resource.data.subtitle is string || request.resource.data.subtitle == null)
        && (!('imageURL' in request.resource.data) || request.resource.data.imageURL is string || request.resource.data.imageURL == null)
        && request.resource.data.createdAt is timestamp;
    }

    function featuredBannerRequiredFields() {
      return [
        'id',
        'imageURL',
        'actionType',
        'regionScope',
        'visibleSections',
        'displayDurationSeconds',
        'priority',
        'isActive',
        'createdAt',
        'updatedAt',
        'createdBy'
      ];
    }

    function featuredBannerAllowedFields() {
      return [
        'id',
        'internalName',
        'title',
        'subtitle',
        'imageURL',
        'actionType',
        'actionTargetID',
        'externalURL',
        'regionScope',
        'federalState',
        'visibleSections',
        'displayDurationSeconds',
        'priority',
        'isActive',
        'startsAt',
        'endsAt',
        'createdAt',
        'updatedAt',
        'createdBy',
        'updatedBy'
      ];
    }

    function featuredBannerActionTypes() {
      return [
        'none',
        'news',
        'event',
        'organization',
        'externalURL'
      ];
    }

    function featuredBannerTargetActionTypes() {
      return ['news', 'event', 'organization'];
    }

    function featuredBannerExternalActionTypes() {
      return ['externalURL'];
    }

    function featuredBannerRegionScopes() {
      return ['allAustria', 'federalState'];
    }

    function featuredBannerFederalStates() {
      return [
        'burgenland',
        'kaernten',
        'niederoesterreich',
        'oberoesterreich',
        'salzburg',
        'steiermark',
        'tirol',
        'vorarlberg',
        'wien'
      ];
    }

    function featuredBannerVisibleSections() {
      return ['home', 'events', 'organizations'];
    }

    function featuredBannerHasValidSections(data) {
      return data.visibleSections is list
        && data.visibleSections.size() > 0
        && data.visibleSections.hasOnly(featuredBannerVisibleSections());
    }

    function featuredBannerHasValidActionPayload(data) {
      return (
          !(data.actionType in featuredBannerTargetActionTypes())
          || (
            ('actionTargetID' in data)
            && data.actionTargetID is string
            && data.actionTargetID.size() > 0
          )
        )
        && (
          !(data.actionType in featuredBannerExternalActionTypes())
          || (
            ('externalURL' in data)
            && data.externalURL is string
            && data.externalURL.size() > 0
            && data.externalURL.matches('^https?://.+')
          )
        );
    }

    function featuredBannerHasValidRegion(data) {
      return data.regionScope in featuredBannerRegionScopes()
        && (
          data.regionScope == 'allAustria'
          || (
            ('federalState' in data)
            && data.federalState is string
            && data.federalState in featuredBannerFederalStates()
          )
        );
    }

    function featuredBannerBaseStructurallyValid(data, bannerId) {
      return data.keys().hasAll(featuredBannerRequiredFields())
        && data.keys().hasOnly(featuredBannerAllowedFields())
        && data.id == bannerId
        && data.id is string
        && (!('internalName' in data) || data.internalName == null || (data.internalName is string && data.internalName.size() <= 120))
        && (!('title' in data) || data.title == null || (data.title is string && data.title.size() <= 120))
        && data.imageURL is string
        && data.imageURL.size() > 0
        && data.imageURL.size() <= 2048
        && data.imageURL.matches('^https?://.+')
        && data.actionType in featuredBannerActionTypes()
        && featuredBannerHasValidActionPayload(data)
        && featuredBannerHasValidRegion(data)
        && data.displayDurationSeconds is int
        && data.displayDurationSeconds >= 3
        && data.displayDurationSeconds <= 12
        && data.priority is int
        && data.priority >= 0
        && data.priority <= 1000
        && data.isActive is bool
        && data.createdAt is timestamp
        && data.updatedAt is timestamp
        && data.createdBy is string
        && data.createdBy.size() > 0
        && (!('updatedBy' in data) || data.updatedBy == null || data.updatedBy is string)
        && (!('subtitle' in data) || data.subtitle == null || (data.subtitle is string && data.subtitle.size() <= 240))
        && (!('actionTargetID' in data) || data.actionTargetID == null || data.actionTargetID is string)
        && (!('externalURL' in data) || data.externalURL == null || (data.externalURL is string && data.externalURL.size() <= 2048))
        && (!('federalState' in data) || data.federalState == null || data.federalState is string)
        && (!('startsAt' in data) || data.startsAt == null || data.startsAt is timestamp)
        && (!('endsAt' in data) || data.endsAt == null || data.endsAt is timestamp)
        && (
          !('startsAt' in data)
          || data.startsAt == null
          || !('endsAt' in data)
          || data.endsAt == null
          || data.startsAt < data.endsAt
        );
    }

    function featuredBannerStructurallyValid(data, bannerId) {
      return featuredBannerBaseStructurallyValid(data, bannerId)
        && featuredBannerHasValidSections(data);
    }

    function validFeaturedBannerCreate(bannerId) {
      return isVerifiedActiveUser()
        && canManageFeaturedBanners()
        && featuredBannerStructurallyValid(request.resource.data, bannerId)
        && request.resource.data.createdBy == request.auth.uid
        && (
          !('updatedBy' in request.resource.data)
          || request.resource.data.updatedBy == null
          || request.resource.data.updatedBy == request.auth.uid
        );
    }

    function featuredBannerMigrationIdentityFieldsAreValid(bannerId) {
      return request.resource.data.id == bannerId
        && (
          (
            (!('createdAt' in resource.data) || !(resource.data.createdAt is timestamp))
            && request.resource.data.createdAt is timestamp
          )
          || (
            resource.data.createdAt is timestamp
            && request.resource.data.createdAt == resource.data.createdAt
          )
        )
        && (
          (
            (
              !('createdBy' in resource.data)
              || !(resource.data.createdBy is string)
              || resource.data.createdBy.size() == 0
            )
            && request.resource.data.createdBy == request.auth.uid
          )
          || (
            resource.data.createdBy is string
            && resource.data.createdBy.size() > 0
            && request.resource.data.createdBy == resource.data.createdBy
          )
        );
    }

    function validFeaturedBannerUpdate(bannerId) {
      return isVerifiedActiveUser()
        && canManageFeaturedBanners()
        && request.resource.data.updatedBy == request.auth.uid
        && (
          (
            request.resource.data.diff(resource.data).affectedKeys().hasOnly([
              'isActive',
              'updatedAt',
              'updatedBy'
            ])
            && request.resource.data.isActive is bool
            && (
              request.resource.data.isActive == false
              || featuredBannerStructurallyValid(resource.data, bannerId)
            )
            && request.resource.data.updatedAt is timestamp
          )
          || (
            featuredBannerStructurallyValid(request.resource.data, bannerId)
            && featuredBannerMigrationIdentityFieldsAreValid(bannerId)
          )
        );
    }

    function canReadFeaturedBanner() {
      return resource.data.isActive == true
        && resource.data.actionType in featuredBannerActionTypes()
        && (
          'home' in resource.data.visibleSections
          || 'events' in resource.data.visibleSections
          || 'organizations' in resource.data.visibleSections
        );
    }

    function safeUserCreate(uid) {
      return isSelf(uid)
        && request.resource.data.keys().hasOnly([
          'id',
          'fullName',
          'displayName',
          'city',
          'email',
          'bio',
          'telegramUsername',
          'isBlocked',
          'blockState',
          'globalRole',
          'selectedFederalState',
          'accountStatus',
          'warningCount',
          'communityMemberships',
          'acceptedTermsAt',
          'acceptedPrivacyAt',
          'acceptedTermsVersion',
          'acceptedPrivacyVersion',
          'termsVersion',
          'privacyVersion',
          'minimumAgeConfirmedAt',
          'minimumAgeVersion',
          'createdAt',
          'updatedAt'
        ])
        && request.resource.data.id == uid
        && request.resource.data.fullName is string
        && request.resource.data.displayName is string
        && request.resource.data.city is string
        && request.resource.data.email is string
        && request.resource.data.bio is string
        && !('role' in request.resource.data)
        && !('moderatorSections' in request.resource.data)
        && !('canManageGuide' in request.resource.data)
        && request.resource.data.isBlocked == false
        && request.resource.data.blockState == 'active'
        && request.resource.data.globalRole == 'user'
        && request.resource.data.selectedFederalState is string
        && request.resource.data.accountStatus == 'active'
        && request.resource.data.warningCount == 0
        && request.resource.data.acceptedTermsAt == request.time
        && request.resource.data.acceptedPrivacyAt == request.time
        && request.resource.data.acceptedTermsVersion is string
        && request.resource.data.acceptedPrivacyVersion is string
        && request.resource.data.termsVersion is string
        && request.resource.data.privacyVersion is string
        && request.resource.data.minimumAgeConfirmedAt == request.time
        && request.resource.data.minimumAgeVersion == '14+'
        && request.resource.data.createdAt is timestamp
        && request.resource.data.createdAt == request.time
        && request.resource.data.updatedAt is timestamp
        && request.resource.data.updatedAt == request.time
        && (
          !('telegramUsername' in request.resource.data)
          || request.resource.data.telegramUsername == null
          || request.resource.data.telegramUsername is string
        )
        && request.resource.data.communityMemberships is list
        && request.resource.data.communityMemberships.size() == 0;
    }

    function safeSelfUserUpdate(uid) {
      return isSelf(uid)
        && isVerifiedActiveUser()
        && request.resource.data.id == resource.data.id
        && request.resource.data.diff(resource.data).affectedKeys().hasOnly(userSelfEditableFields())
        && request.resource.data.fullName is string
        && request.resource.data.fullName.size() > 0
        && request.resource.data.fullName.size() <= 160
        && request.resource.data.displayName is string
        && request.resource.data.displayName.size() > 0
        && request.resource.data.displayName.size() <= 160
        && request.resource.data.city is string
        && request.resource.data.city.size() <= 160
        && request.resource.data.bio is string
        && request.resource.data.bio.size() <= 2000
        && request.resource.data.email == resource.data.email
        && request.resource.data.selectedFederalState is string
        && request.resource.data.updatedAt is timestamp
        && validOptionalString(request.resource.data, 'telegramUsername', 80)
        && validOptionalString(request.resource.data, 'avatarURL', 2048);
    }

    function safeSelfStatusAcknowledgement(uid) {
      return isSelf(uid)
        && isVerifiedActiveUser()
        && request.resource.data.id == resource.data.id
        && ('statusUpdatedAt' in resource.data)
        && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['statusAcknowledgedAt'])
        && request.resource.data.statusAcknowledgedAt is timestamp
        && request.resource.data.statusAcknowledgedAt >= resource.data.statusUpdatedAt;
    }

    function safeSelfAccountDeletionUpdate(uid) {
      return isSelf(uid)
        && isActiveUser()
        && request.resource.data.id == resource.data.id
        && ('globalRole' in resource.data)
        && resource.data.globalRole != 'owner'
        && request.resource.data.globalRole == resource.data.globalRole
        && (!('role' in resource.data) || request.resource.data.role == resource.data.role)
        && (!('createdAt' in resource.data) || request.resource.data.createdAt == resource.data.createdAt)
        && (!('communityMemberships' in resource.data) || request.resource.data.communityMemberships == resource.data.communityMemberships)
        && request.resource.data.diff(resource.data).affectedKeys().hasOnly(userSelfDeletionFields())
        && request.resource.data.accountStatus == 'deactivated'
        && request.resource.data.blockState == 'deactivated'
        && request.resource.data.isBlocked == true
        && request.resource.data.displayName == 'Видалений користувач'
        && request.resource.data.fullName == ''
        && request.resource.data.bio == ''
        && request.resource.data.city == ''
        && request.resource.data.email == ''
        && (!('telegramUsername' in request.resource.data) || request.resource.data.telegramUsername == null)
        && (!('avatarURL' in request.resource.data) || request.resource.data.avatarURL == null)
        && request.resource.data.updatedAt is timestamp;
    }

    function ownerUserEditableFields() {
      return ['accountStatus', 'blockState', 'warningCount', 'updatedAt', 'isBlocked', 'banExpiresAt'];
    }

    function safeOwnerUserUpdate(uid) {
      return isOwner()
        && uid != request.auth.uid
        && request.resource.data.id == resource.data.id
        && ('globalRole' in resource.data)
        && resource.data.globalRole != 'owner'
        && request.resource.data.globalRole == resource.data.globalRole
        && (!('role' in resource.data) || request.resource.data.role == resource.data.role)
        && (!('createdAt' in resource.data) || request.resource.data.createdAt == resource.data.createdAt)
        && (!('communityMemberships' in resource.data) || request.resource.data.communityMemberships == resource.data.communityMemberships)
        && request.resource.data.diff(resource.data).affectedKeys().hasOnly(ownerUserEditableFields());
    }

    function canModerateAppContent(section) {
      return canModerateSection(section);
    }

    function hasOrganizationRole(organizationId, role) {
      return isVerifiedActiveUser()
        && organizationId is string
        && (
          (
            role == 'communityOwner'
            && ('ownerId' in get(/databases/$(database)/documents/organizations/$(organizationId)).data)
            && get(/databases/$(database)/documents/organizations/$(organizationId)).data.ownerId == request.auth.uid
          )
          || (
            role == 'communityAdmin'
            && ('adminIds' in get(/databases/$(database)/documents/organizations/$(organizationId)).data)
            && get(/databases/$(database)/documents/organizations/$(organizationId)).data.adminIds.hasAny([request.auth.uid])
          )
          || (
            role == 'communityModerator'
            && ('moderatorIds' in get(/databases/$(database)/documents/organizations/$(organizationId)).data)
            && get(/databases/$(database)/documents/organizations/$(organizationId)).data.moderatorIds.hasAny([request.auth.uid])
          )
        );
    }

    function isOrganizationOwner(organizationId) {
      return hasOrganizationRole(organizationId, 'communityOwner');
    }

    function isOrganizationAdmin(organizationId) {
      return hasOrganizationRole(organizationId, 'communityAdmin');
    }

    function isOrganizationModerator(organizationId) {
      return hasOrganizationRole(organizationId, 'communityModerator');
    }

    function canEditOrganizationContent(organizationId) {
      let organization = get(/databases/$(database)/documents/organizations/$(organizationId)).data;
      return isVerifiedActiveUser()
        && organizationId is string
        && organizationId.size() > 0
        && (
          (('ownerId' in organization) && organization.ownerId == request.auth.uid)
          || (('adminIds' in organization) && organization.adminIds.hasAny([request.auth.uid]))
          || (('moderatorIds' in organization) && organization.moderatorIds.hasAny([request.auth.uid]))
        );
    }

    function canReadOrganizationByLookup(organizationId) {
      return canUseOrganizationOverride()
        || (exists(/databases/$(database)/documents/organizations/$(organizationId))
        && (
          get(/databases/$(database)/documents/organizations/$(organizationId)).data.moderationStatus == 'approved'
          || canEditOrganizationContent(organizationId)
          || (
            canManageOrganizationRequests()
            && get(/databases/$(database)/documents/organizations/$(organizationId)).data.moderationStatus in ['pendingReview', 'needsRevision', 'rejected']
          )
          || (
            isVerifiedActiveUser()
            && ('submittedByUserId' in get(/databases/$(database)/documents/organizations/$(organizationId)).data)
            && get(/databases/$(database)/documents/organizations/$(organizationId)).data.submittedByUserId == request.auth.uid
            && get(/databases/$(database)/documents/organizations/$(organizationId)).data.moderationStatus in ['pendingReview', 'needsRevision', 'rejected']
          )
        ));
    }

    function canReadOrganization(organizationId) {
      return canUseOrganizationOverride()
        || (('moderationStatus' in resource.data) && resource.data.moderationStatus == 'approved')
        || (
          canManageOrganizationRequests()
          && resource.data.moderationStatus in ['pendingReview', 'needsRevision', 'rejected']
        )
        || (
          isVerifiedActiveUser()
          && ('submittedByUserId' in resource.data)
          && resource.data.submittedByUserId == request.auth.uid
          && resource.data.moderationStatus in ['pendingReview', 'needsRevision', 'rejected']
        )
        || canEditOrganizationContent(organizationId);
    }

    function canListOrganization() {
      return (('moderationStatus' in resource.data) && resource.data.moderationStatus == 'approved')
        || (
          isVerifiedActiveUser()
          && ('ownerId' in resource.data)
          && resource.data.ownerId == request.auth.uid
        )
        || (
          canManageOrganizationRequests()
          && resource.data.moderationStatus in ['pendingReview', 'needsRevision', 'rejected']
        )
        || (
          isVerifiedActiveUser()
          && ('submittedByUserId' in resource.data)
          && resource.data.submittedByUserId == request.auth.uid
          && resource.data.moderationStatus in ['pendingReview', 'needsRevision', 'rejected']
        );
    }

    function canModerateOrganizationContent(organizationId) {
      return canEditOrganizationContent(organizationId);
    }

    function canEditOrganizationInfo(organizationId) {
      return isVerifiedActiveUser()
        && organizationId is string
        && (
          (
            ('globalRole' in currentUserData())
            && currentUserData().globalRole == 'owner'
          )
          || (
            ('ownerId' in resource.data)
            && resource.data.ownerId == request.auth.uid
          )
          || (
            ('adminIds' in resource.data)
            && resource.data.adminIds is list
            && resource.data.adminIds.hasAny([request.auth.uid])
          )
        );
    }

    function organizationSafeInfoFields() {
      return [
        'name',
        'localizations',
        'description',
        'shortDescription',
        'fullDescription',
        'imageURL',
        'logoURL',
        'coverURL',
        'contactEmail',
        'website',
        'email',
        'phone',
        'address',
        'latitude',
        'longitude',
        'regionScope',
        'city',
        'federalState',
        'organizationType',
        'directoryProfile',
        'foundedYear',
        'foundedMonth',
        'languages',
        'socialLinks',
        'telegramURL',
        'donationURL',
        'facebookURL',
        'instagramURL',
        'whatsappURL',
        'youtubeURL',
        'linkedinURL',
        'missionStatement',
        'contactPerson',
        'moderationStatus',
        'updatedAt'
      ];
    }

    function organizationHasValidRegionScope(data) {
      return !('regionScope' in data)
        || data.regionScope in ['austria', 'federalState', 'city'];
    }

    function organizationHasValidDirectoryProfile(data) {
      let profile = data.get('directoryProfile', null);
      return !('directoryProfile' in data)
        || (
          profile is map
          && profile.keys().hasOnly([
            'profileKind',
            'secondaryCategories',
            'serviceModes',
            'serviceArea',
            'regularHours',
            'specialHoursNote',
            'services',
            'orderURL',
            'bookingURL',
            'currentOfferTitle',
            'currentOfferDetails',
            'currentOfferURL',
            'currentOfferValidUntil'
          ])
          && ('profileKind' in profile)
          && profile.profileKind in ['community', 'business', 'restaurant', 'specialist', 'institution', 'mediaProject']
          && (!('secondaryCategories' in profile)
            || (profile.secondaryCategories is list
              && profile.secondaryCategories.size() <= 2))
          && (!('serviceModes' in profile)
            || (profile.serviceModes is list
              && profile.serviceModes.size() <= 5))
          && (!('regularHours' in profile)
            || (profile.regularHours is map
              && profile.regularHours.keys().hasOnly(['monday', 'tuesday', 'wednesday', 'thursday', 'friday', 'saturday', 'sunday'])))
          && (!('services' in profile)
            || (profile.services is list
              && profile.services.size() <= 8))
          && (!('currentOfferValidUntil' in profile)
            || profile.currentOfferValidUntil is timestamp)
        );
    }

    function safeOrganizationInfoUpdate(organizationId) {
      return canEditOrganizationInfo(organizationId)
        && organizationDocumentStructurallyValid(request.resource.data, organizationId)
        && request.resource.data.moderationStatus == resource.data.moderationStatus
        && request.resource.data.diff(resource.data).affectedKeys().hasOnly(organizationSafeInfoFields());
    }

    function organizationRequestCreateFields() {
      return [
        'name',
        'localizations',
        'description',
        'shortDescription',
        'fullDescription',
        'imageURL',
        'logoURL',
        'coverURL',
        'contactEmail',
        'website',
        'email',
        'phone',
        'address',
        'latitude',
        'longitude',
        'regionScope',
        'city',
        'federalState',
        'organizationType',
        'directoryProfile',
        'foundedYear',
        'foundedMonth',
        'languages',
        'socialLinks',
        'telegramURL',
        'donationURL',
        'facebookURL',
        'instagramURL',
        'whatsappURL',
        'youtubeURL',
        'linkedinURL',
        'missionStatement',
        'contactPerson',
        'moderationStatus',
        'updatedAt',
        'id',
        'subscriberCount',
        'eventsHeldCount',
        'volunteersCount',
        'helpedPeopleCount',
        'adminIds',
        'moderatorIds',
        'createdAt',
        'likeCount',
        'likeState',
        'ownerId',
        'submittedByUserId',
        'submittedByDisplayName',
        'submittedAt',
        'isSystemManaged',
        'sourceType',
        'pinnedNewsId',
        'pinnedEventId',
        'reviewMessage',
        'reviewedByUserId',
        'reviewedAt',
        'rejectionReason'
      ];
    }

    function organizationRequestUpdateFields() {
      return [
        'name',
        'localizations',
        'description',
        'shortDescription',
        'fullDescription',
        'imageURL',
        'logoURL',
        'coverURL',
        'contactEmail',
        'website',
        'email',
        'phone',
        'address',
        'latitude',
        'longitude',
        'regionScope',
        'city',
        'federalState',
        'organizationType',
        'directoryProfile',
        'foundedYear',
        'foundedMonth',
        'languages',
        'socialLinks',
        'telegramURL',
        'donationURL',
        'facebookURL',
        'instagramURL',
        'whatsappURL',
        'youtubeURL',
        'linkedinURL',
        'missionStatement',
        'contactPerson',
        'moderationStatus',
        'updatedAt',
        'submittedAt',
        'reviewMessage',
        'rejectionReason'
      ];
    }

    function requestCountersAreZero(data) {
      return data.subscriberCount == 0
        && data.likeCount == 0
        && data.eventsHeldCount == 0
        && data.volunteersCount == 0
        && data.helpedPeopleCount == 0
        && data.likeState == 'notLiked';
    }

    function requestRolesAreEmpty(data) {
      return data.adminIds is list
        && data.adminIds.size() == 0
        && data.moderatorIds is list
        && data.moderatorIds.size() == 0
        && (!('ownerId' in data) || data.ownerId == null || data.ownerId == '');
    }

    function organizationDocumentStructurallyValid(data, organizationId) {
      return data.keys().hasOnly(organizationRequestCreateFields())
        && data.id == organizationId
        && data.name is string && data.name.size() > 0 && data.name.size() <= 180
        && data.description is string && data.description.size() <= 1000
        && data.city is string && data.city.size() <= 160
        && data.createdAt is timestamp
        && data.updatedAt is timestamp
        && data.moderationStatus in ['pendingReview', 'approved', 'needsRevision', 'rejected', 'archived']
        && data.subscriberCount is int && data.subscriberCount >= 0
        && data.eventsHeldCount is int && data.eventsHeldCount >= 0
        && data.volunteersCount is int && data.volunteersCount >= 0
        && data.helpedPeopleCount is int && data.helpedPeopleCount >= 0
        && data.likeCount is int && data.likeCount >= 0
        && data.likeState is string
        && data.adminIds is list
        && data.moderatorIds is list
        && (!('languages' in data) || (data.languages is list && data.languages.size() <= 12))
        && (!('socialLinks' in data) || data.socialLinks is map)
        && validOptionalString(data, 'imageURL', 2048)
        && validOptionalString(data, 'logoURL', 2048)
        && validOptionalString(data, 'coverURL', 2048)
        && validOptionalString(data, 'website', 2048)
        && validOptionalString(data, 'contactEmail', 320)
        && validOptionalString(data, 'email', 320)
        && validOptionalString(data, 'phone', 80)
        && validOptionalString(data, 'address', 500)
        && organizationHasValidRegionScope(data)
        && organizationHasValidDirectoryProfile(data);
    }

    function safeRequestReviewFieldsUpdate(before, after) {
      return after.moderationStatus == before.moderationStatus
        ? !after.diff(before).affectedKeys().hasAny(['reviewMessage', 'rejectionReason'])
        : after.moderationStatus == 'pendingReview'
          && before.moderationStatus in ['needsRevision', 'rejected']
          && after.get('reviewMessage', null) == null
          && after.get('rejectionReason', null) == null;
    }

    function safeOrganizationCreate(organizationId) {
      let data = request.resource.data;
      // Evaluate shared authentication, legal evidence and schema once. Trying
      // the owner path and then the requester path exceeds the Rules expression
      // budget for a fully populated directory profile with acceptance proof.
      return isVerifiedActiveUser()
        && hasValidOrganizationCreationProof(organizationId, data.name)
        && organizationDocumentStructurallyValid(data, organizationId)
        && (
          data.moderationStatus == 'pendingReview'
            ? data.submittedByUserId == request.auth.uid
              && data.submittedAt is timestamp
              && requestCountersAreZero(data)
              && requestRolesAreEmpty(data)
            : data.moderationStatus == 'approved'
              && currentUserData().get('globalRole', '') == 'owner'
              && aggregateCountersAreZeroOnCreate(data)
        );
    }

    function hasValidOrganizationCreationProof(organizationId, organizationName) {
      let rulesPath = /databases/$(database)/documents/legalDocuments/organizationRules;
      let proofPath = /databases/$(database)/documents/organizationCreationProofs/$(organizationId);
      return !exists(rulesPath)
        || get(rulesPath).data.requiresAcceptance != true
        || (exists(proofPath) && organizationCreationProofMatches(
          proofPath,
          rulesPath,
          organizationId,
          organizationName
        ));
    }

    function organizationCreationProofMatches(proofPath, rulesPath, organizationId, organizationName) {
      let proof = get(proofPath).data;
      let rules = get(rulesPath).data;
      return proof.userId == request.auth.uid
        && proof.documentType == 'organizationRules'
        && proof.organizationId == organizationId
        && proof.organizationName == organizationName
        && proof.version == rules.activeVersion
        && proof.acceptedAt is timestamp
        && proof.expiresAt is timestamp
        && proof.expiresAt > request.time;
    }

    function safeOrganizationRequestUpdate() {
      let before = resource.data;
      let after = request.resource.data;
      return organizationDocumentStructurallyValid(after, before.id)
        && ('submittedByUserId' in before)
        && before.submittedByUserId == request.auth.uid
        && after.submittedByUserId == before.submittedByUserId
        // Counters and roles cannot change (the diff whitelist below excludes
        // them), so validating their resulting values also validates the old ones.
        && requestCountersAreZero(after)
        && requestRolesAreEmpty(after)
        && before.moderationStatus in ['pendingReview', 'needsRevision', 'rejected']
        && after.moderationStatus in ['pendingReview', before.moderationStatus]
        && safeRequestReviewFieldsUpdate(before, after)
        && after.diff(before).affectedKeys().hasOnly(organizationRequestUpdateFields())
        && isVerifiedActiveUser();
    }

    function ownDocumentRead() {
      return isVerifiedActiveUser()
        && resource.data.userId == request.auth.uid;
    }

    function ownLikeDocumentRead(likeId) {
      return isVerifiedActiveUser()
        && likeId.matches('^.+_' + request.auth.uid + '$');
    }

    function ownDocumentDelete() {
      return isVerifiedActiveUser()
        && resource.data.userId == request.auth.uid;
    }

    function newsLikeFields() {
      return ['id', 'userId', 'newsId', 'createdAt'];
    }

    function eventLikeFields() {
      return ['id', 'userId', 'eventId', 'createdAt'];
    }

    function organizationLikeFields() {
      return ['id', 'userId', 'organizationId', 'createdAt'];
    }

    function organizationSubscriptionFields() {
      return ['id', 'userId', 'subscribedOrganizationId', 'createdAt'];
    }

    function validBaseLikeCreate(likeId) {
      return isVerifiedActiveUser()
        && request.resource.data.id == likeId
        && request.resource.data.userId == request.auth.uid
        && request.resource.data.createdAt == request.time;
    }

    function approvedNewsTargetExists(newsId) {
      return exists(/databases/$(database)/documents/news/$(newsId))
        && get(/databases/$(database)/documents/news/$(newsId)).data.moderationStatus == 'approved';
    }

    function approvedEventTargetExists(eventId) {
      return exists(/databases/$(database)/documents/events/$(eventId))
        && get(/databases/$(database)/documents/events/$(eventId)).data.moderationStatus == 'approved';
    }

    function approvedOrganizationTargetExists(organizationId) {
      return exists(/databases/$(database)/documents/organizations/$(organizationId))
        && get(/databases/$(database)/documents/organizations/$(organizationId)).data.moderationStatus == 'approved';
    }

    function validNewsLikeCreate(likeId) {
      return validBaseLikeCreate(likeId)
        && request.resource.data.keys().hasOnly(newsLikeFields())
        && request.resource.data.newsId is string
        && request.resource.data.newsId.size() > 0
        && !request.resource.data.newsId.matches('^(event_|organization_).*')
        && likeId == request.resource.data.newsId + '_' + request.auth.uid
        && approvedNewsTargetExists(request.resource.data.newsId);
    }

    function validEventLikeCreate(likeId) {
      return validBaseLikeCreate(likeId)
        && request.resource.data.keys().hasOnly(eventLikeFields())
        && request.resource.data.eventId is string
        && request.resource.data.eventId.size() > 0
        && likeId == 'event_' + request.resource.data.eventId + '_' + request.auth.uid
        && approvedEventTargetExists(request.resource.data.eventId);
    }

    function validOrganizationLikeCreate(likeId) {
      return validBaseLikeCreate(likeId)
        && request.resource.data.keys().hasOnly(organizationLikeFields())
        && request.resource.data.organizationId is string
        && request.resource.data.organizationId.size() > 0
        && !request.resource.data.organizationId.matches('^follow_.*')
        && likeId == 'organization_' + request.resource.data.organizationId + '_' + request.auth.uid
        && approvedOrganizationTargetExists(request.resource.data.organizationId);
    }

    function validOrganizationSubscriptionCreate(likeId) {
      return validBaseLikeCreate(likeId)
        && request.resource.data.keys().hasOnly(organizationSubscriptionFields())
        && request.resource.data.subscribedOrganizationId is string
        && request.resource.data.subscribedOrganizationId.size() > 0
        && likeId == 'organization_follow_' + request.resource.data.subscribedOrganizationId + '_' + request.auth.uid
        && approvedOrganizationTargetExists(request.resource.data.subscribedOrganizationId);
    }

    function canReadOrganizationSubscription() {
      // Subscriber identities are private. Organization owners may query their
      // own subscriber list; users and App Owner retain the own/override paths.
      return ('subscribedOrganizationId' in resource.data)
        && resource.data.subscribedOrganizationId is string
        && isOrganizationOwner(resource.data.subscribedOrganizationId);
    }

    function validLikeCreate(likeId) {
      // Route by the one canonical target field before evaluating the more
      // expensive authorization branch. This stays below the rules expression
      // budget on denied writes and keys().hasOnly still rejects mixed targets.
      return ('newsId' in request.resource.data)
        ? validNewsLikeCreate(likeId)
        : ('eventId' in request.resource.data)
          ? validEventLikeCreate(likeId)
          : ('organizationId' in request.resource.data)
            ? validOrganizationLikeCreate(likeId)
            : ('subscribedOrganizationId' in request.resource.data)
              ? validOrganizationSubscriptionCreate(likeId)
              : false;
    }

    function validAnalyticsActionProofCreate(proofId) {
      return isVerifiedActiveUser()
        && request.resource.data.keys().hasOnly([
          'proofId',
          'eventName',
          'contentId',
          'actorBinding',
          'sessionBinding',
          'createdAt',
          'expiresAt'
        ])
        && request.resource.data.proofId == proofId
        && proofId.matches('^[0-9A-Fa-f-]{36}$')
        && request.resource.data.eventName in [
          'news_like',
          'news_bookmark',
          'event_bookmark',
          'organization_follow',
          'organization_bookmark'
        ]
        && request.resource.data.contentId is string
        && request.resource.data.contentId.size() > 0
        && request.resource.data.contentId.size() <= 512
        && !request.resource.data.contentId.matches('.*\\/.*')
        && request.resource.data.actorBinding.matches('^[0-9a-f]{64}$')
        && request.resource.data.sessionBinding.matches('^[0-9a-f]{64}$')
        && request.resource.data.createdAt == request.time
        && request.resource.data.expiresAt > request.time + duration.value(47, 'h')
        && request.resource.data.expiresAt <= request.time + duration.value(48, 'h')
        && analyticsActionTargetCreatedInSameWrite(
          request.resource.data.eventName,
          request.resource.data.contentId
        );
    }

    function analyticsActionTargetCreatedInSameWrite(eventName, contentId) {
      return eventName == 'news_like'
        ? !exists(/databases/$(database)/documents/likes/$(contentId + '_' + request.auth.uid))
          && existsAfter(/databases/$(database)/documents/likes/$(contentId + '_' + request.auth.uid))
        : eventName == 'news_bookmark'
          ? !exists(/databases/$(database)/documents/users/$(request.auth.uid)/newsBookmarks/$(contentId))
            && existsAfter(/databases/$(database)/documents/users/$(request.auth.uid)/newsBookmarks/$(contentId))
          : eventName == 'event_bookmark'
            ? !exists(/databases/$(database)/documents/users/$(request.auth.uid)/eventBookmarks/$(contentId))
              && existsAfter(/databases/$(database)/documents/users/$(request.auth.uid)/eventBookmarks/$(contentId))
            : eventName == 'organization_follow'
              ? !exists(/databases/$(database)/documents/likes/$('organization_follow_' + contentId + '_' + request.auth.uid))
                && existsAfter(/databases/$(database)/documents/likes/$('organization_follow_' + contentId + '_' + request.auth.uid))
              : eventName == 'organization_bookmark'
                ? !exists(/databases/$(database)/documents/users/$(request.auth.uid)/organizationBookmarks/$(contentId))
                  && existsAfter(/databases/$(database)/documents/users/$(request.auth.uid)/organizationBookmarks/$(contentId))
                : false;
    }

    function isOrganizationContent(data) {
      return ('sourceType' in data)
        && data.sourceType == 'organization'
        && ('organizationId' in data)
        && data.organizationId is string
        && data.organizationId.size() > 0;
    }

    function aggregateCountersAreZeroOnCreate(data) {
      return (!('likeCount' in data) || data.likeCount == 0)
        && (!('commentCount' in data) || data.commentCount == 0)
        && (!('viewCount' in data) || data.viewCount == 0)
        && (!('registeredCount' in data) || data.registeredCount == 0);
    }

    function aggregateCountersArePreservedOnUpdate() {
      return (!('likeCount' in resource.data) || request.resource.data.likeCount == resource.data.likeCount)
        && (!('commentCount' in resource.data) || request.resource.data.commentCount == resource.data.commentCount)
        && (!('viewCount' in resource.data) || request.resource.data.viewCount == resource.data.viewCount)
        && (!('registeredCount' in resource.data) || request.resource.data.registeredCount == resource.data.registeredCount);
    }

    function canCreateOrganizationContent() {
      // Current policy: organization team members create approved content within their organization.
      return isOrganizationContent(request.resource.data)
        && aggregateCountersAreZeroOnCreate(request.resource.data)
        && (canUseOrganizationOverride() || canEditOrganizationContent(request.resource.data.organizationId));
    }

    function canUpdateOrganizationContent() {
      return isOrganizationContent(resource.data)
        && isOrganizationContent(request.resource.data)
        && request.resource.data.sourceType == resource.data.sourceType
        && request.resource.data.organizationId == resource.data.organizationId
        && aggregateCountersArePreservedOnUpdate()
        && (canUseOrganizationOverride() || canEditOrganizationContent(resource.data.organizationId));
    }

    function canUpdateAppContent() {
      return isOwner()
        && ('sourceType' in resource.data)
        && resource.data.sourceType == 'app'
        && ('sourceType' in request.resource.data)
        && request.resource.data.sourceType == 'app'
        && aggregateCountersArePreservedOnUpdate();
    }

    function canModerateNewsComment(newsId) {
      return canModerateAppContent('news')
        || (
          get(/databases/$(database)/documents/news/$(newsId)).data.sourceType == 'organization'
          && canModerateOrganizationContent(get(/databases/$(database)/documents/news/$(newsId)).data.organizationId)
        );
    }

    function canModerateEventComment(eventId) {
      return canModerateAppContent('events')
        || (
          get(/databases/$(database)/documents/events/$(eventId)).data.sourceType == 'organization'
          && canModerateOrganizationContent(get(/databases/$(database)/documents/events/$(eventId)).data.organizationId)
        );
    }

    function canReadManagedEventRegistration() {
      return isVerifiedActiveUser()
        && ('eventId' in resource.data)
        && resource.data.eventId is string
        && exists(/databases/$(database)/documents/events/$(resource.data.eventId))
        && (
          canModerateAppContent('events')
          || (
            get(/databases/$(database)/documents/events/$(resource.data.eventId)).data.sourceType == 'organization'
            && ('organizationId' in get(/databases/$(database)/documents/events/$(resource.data.eventId)).data)
            && canModerateOrganizationContent(get(/databases/$(database)/documents/events/$(resource.data.eventId)).data.organizationId)
          )
        );
    }

    function canModerateOrganizationComment(organizationId) {
      return canModerateSection('comments')
        || canModerateOrganizationContent(organizationId);
    }

    function donationConfigFields() {
      return [
        'isEnabled',
        'donationURL',
        'titleUK',
        'messageUK',
        'buttonTitleUK',
        'titleDE',
        'messageDE',
        'buttonTitleDE',
        'updatedAt',
        'updatedBy'
      ];
    }

    function validDonationConfigWrite() {
      return isAppOwner()
        && request.resource.data.keys().hasOnly(donationConfigFields())
        && request.resource.data.keys().hasAll(donationConfigFields())
        && request.resource.data.isEnabled is bool
        && request.resource.data.donationURL is string
        && request.resource.data.titleUK is string
        && request.resource.data.messageUK is string
        && request.resource.data.buttonTitleUK is string
        && request.resource.data.titleDE is string
        && request.resource.data.messageDE is string
        && request.resource.data.buttonTitleDE is string
        && request.resource.data.updatedAt is timestamp
        && request.resource.data.updatedBy == request.auth.uid
        && (
          request.resource.data.donationURL == ''
          || request.resource.data.donationURL.matches('https://.*')
        )
        && (
          request.resource.data.isEnabled == false
          || request.resource.data.donationURL.matches('https://.+')
        );
    }

    function canReadModerationQueue(section) {
      return canModerateSection(section);
    }

    function canReadOrganizationModerationQueue(data) {
      return isOrganizationContent(data)
        && canModerateOrganizationContent(data.organizationId)
        && (
          data.moderationStatus == 'pendingReview'
          || data.moderationStatus == 'rejected'
          || data.moderationStatus == 'archived'
        );
    }

    function onlyModerationStatusChanged() {
      return request.resource.data.diff(resource.data).affectedKeys().hasOnly(['moderationStatus', 'updatedAt'])
        && request.resource.data.moderationStatus != resource.data.moderationStatus
        && request.resource.data.updatedAt is timestamp;
    }

    function hasRegistrationForEvent(eventId) {
      return isVerifiedActiveUser()
        && exists(/databases/$(database)/documents/registrations/$(registrationDocumentId(eventId)));
    }

    function registrationDocumentId(eventId) {
      return 'event_' + eventId + '_' + request.auth.uid;
    }

    function canReadCancelledRegisteredEvent(eventId) {
      return resource.data.moderationStatus == 'archived'
        && resource.data.cancellationState == 'cancelled'
        && hasRegistrationForEvent(eventId);
    }

    function notificationPreferenceFields() {
      return ['notificationsEnabled', 'eventRemindersEnabled', 'reminderLeadMinutes', 'updatedAt'];
    }

    function notificationUserMutableFields() {
      return [
        'isRead',
        'readAt',
        'archivedAt',
        'deletedAt',
        'popupPresentedAt'
      ];
    }

    function validNotificationOptionalTimestamp(field) {
      return !(field in request.resource.data)
        || request.resource.data[field] is timestamp
        || request.resource.data[field] == null;
    }

    function validNotificationUserUpdate(uid) {
      return isSelf(uid)
        && request.resource.data.diff(resource.data).affectedKeys().hasOnly(notificationUserMutableFields())
        && request.resource.data.isRead is bool
        && validNotificationOptionalTimestamp('readAt')
        && validNotificationOptionalTimestamp('archivedAt')
        && validNotificationOptionalTimestamp('deletedAt')
        && validNotificationOptionalTimestamp('popupPresentedAt');
    }

    function validNotificationPreferencesWrite(uid) {
      return isVerifiedActiveUser()
        && request.auth.uid == uid
        && request.resource.data.keys().hasOnly(notificationPreferenceFields())
        && request.resource.data.notificationsEnabled is bool
        && request.resource.data.eventRemindersEnabled is bool
        && request.resource.data.reminderLeadMinutes is int
        && request.resource.data.reminderLeadMinutes >= 0
        && request.resource.data.reminderLeadMinutes <= 10080
        && request.resource.data.updatedAt is timestamp;
    }

    function validPublicProfileWrite(uid) {
      return request.resource.data.keys().hasOnly([
          'id',
          'displayName',
          'avatarURL',
          'city',
          'federalState',
          'updatedAt'
        ])
        && request.resource.data.id == uid
        && request.resource.data.displayName is string
        && request.resource.data.displayName.size() > 0
        && request.resource.data.city is string
        && request.resource.data.updatedAt is timestamp
        && (!('avatarURL' in request.resource.data) || request.resource.data.avatarURL is string)
        && (!('federalState' in request.resource.data) || request.resource.data.federalState is string);
    }

    match /publicProfiles/{uid} {
      allow read: if true;

      allow create, update: if (isVerifiedActiveUser() && request.auth.uid == uid && validPublicProfileWrite(uid))
        || (isOwner() && validPublicProfileWrite(uid));

      allow delete: if isOwner() || (isVerifiedActiveUser() && request.auth.uid == uid);
    }

    match /legalDocuments/{documentType} {
      allow read: if isLegalDocumentType(documentType);

      allow create, update: if isOwner()
        && validLegalDocumentPointer(documentType);

      allow delete: if false;

      match /versions/{version} {
        allow read: if isOwner()
          || (isLegalDocumentType(documentType)
            && resource.data.status == 'published'
            && get(/databases/$(database)/documents/legalDocuments/$(documentType))
              .data.activeVersion == version);

        allow create: if isOwner()
          && validLegalDocumentVersion(documentType, version);

        allow update: if isOwner()
          && resource.data.status != 'published'
          && request.resource.data.documentType == resource.data.documentType
          && request.resource.data.version == resource.data.version
          && request.resource.data.createdAt == resource.data.createdAt
          && request.resource.data.createdBy == resource.data.createdBy
          && validLegalDocumentVersion(documentType, version);

        allow delete: if false;
      }
    }

    match /legalAcceptanceLogs/{logId} {
      allow read: if isOwner() || (isSignedIn() && resource.data.userId == request.auth.uid);
      allow create, update, delete: if false;
    }

    match /organizationCreationProofs/{organizationId} {
      allow read, create, update, delete: if false;
    }

    match /users/{uid} {
      allow read: if isSelf(uid) || canManageUsers();

      allow create: if safeUserCreate(uid);

      allow update: if safeOwnerUserUpdate(uid)
        || safeSelfUserUpdate(uid)
        || safeSelfStatusAcknowledgement(uid)
        || safeSelfAccountDeletionUpdate(uid);

      allow delete: if false;

      // Presence is read/written only through authorized Cloud Functions.
      // In particular, it is NOT readable by the account itself or organization staff.
      match /privatePresence/{docId} {
        allow read, write: if false;
      }

      match /notificationPreferences/{docId} {
        allow read: if isSelf(uid) && docId == 'settings';

        allow create, update: if docId == 'settings'
          && validNotificationPreferencesWrite(uid);

        allow delete: if isVerifiedActiveUser()
          && request.auth.uid == uid
          && docId == 'settings';
      }

      match /notificationInbox/{notificationId} {
        allow read: if isSelf(uid);

        allow create: if false;

        allow update: if validNotificationUserUpdate(uid);

        allow delete: if false;
      }

      // Private content-planning drafts are created only by the trusted backend.
      // The app owner may review them and only move them to terminal states after
      // publishing or explicitly archiving; payload and provenance stay immutable.
      match /contentPlanningDrafts/{draftId} {
        allow read: if isSelf(uid) && isAppOwner();

        allow create, delete: if false;

        allow update: if isSelf(uid)
          && isAppOwner()
          && request.resource.data.diff(resource.data).affectedKeys()
            .hasOnly(['state', 'updatedAt', 'completedAt'])
          && request.resource.data.state in ['completed', 'archived']
          && request.resource.data.updatedAt is timestamp
          && (
            request.resource.data.state == 'archived'
            || request.resource.data.completedAt is timestamp
          );
      }

      // Sanitized DSA statements are written only by trusted backend code.
      // They intentionally exclude the reporter's identity, contact data and evidence.
      match /dsaStatements/{statementId} {
        allow read: if isSelf(uid);
        allow create, update, delete: if false;
      }

      match /notificationPushTokens/{tokenId} {
        allow read: if false;

        allow create, update: if validNotificationPushTokenWrite(uid, tokenId);

        allow delete: if isSelf(uid);
      }

      match /blockedUsers/{targetUserId} {
        allow read: if isSelf(uid);
        allow create, update, delete: if false;
      }

      match /newsBookmarks/{newsId} {
        allow read: if isSelf(uid);

        allow create: if isVerifiedActiveUser()
          && request.auth.uid == uid
          && request.resource.data.keys().hasOnly(['id', 'newsId', 'userId', 'createdAt'])
          && request.resource.data.id == newsId
          && request.resource.data.newsId == newsId
          && request.resource.data.userId == uid
          && request.resource.data.createdAt == request.time
          && approvedNewsTargetExists(newsId);

        allow update: if false;

        allow delete: if isVerifiedActiveUser()
          && request.auth.uid == uid
          && resource.data.newsId == newsId
          && resource.data.userId == uid;
      }

      match /eventBookmarks/{eventId} {
        allow read: if isSelf(uid);

        allow create: if isVerifiedActiveUser()
          && request.auth.uid == uid
          && request.resource.data.keys().hasOnly(['id', 'eventId', 'userId', 'createdAt'])
          && request.resource.data.id == eventId
          && request.resource.data.eventId == eventId
          && request.resource.data.userId == uid
          && request.resource.data.createdAt == request.time
          && approvedEventTargetExists(eventId);

        allow update: if false;

        allow delete: if isVerifiedActiveUser()
          && request.auth.uid == uid
          && resource.data.eventId == eventId
          && resource.data.userId == uid;
      }

      match /organizationBookmarks/{organizationId} {
        allow read: if isSelf(uid);

        allow create: if isVerifiedActiveUser()
          && request.auth.uid == uid
          && request.resource.data.keys().hasOnly(['id', 'organizationId', 'userId', 'createdAt'])
          && request.resource.data.id == organizationId
          && request.resource.data.organizationId == organizationId
          && request.resource.data.userId == uid
          && request.resource.data.createdAt == request.time
          && approvedOrganizationTargetExists(organizationId);

        allow update: if false;

        allow delete: if isVerifiedActiveUser()
          && request.auth.uid == uid
          && resource.data.organizationId == organizationId
          && resource.data.userId == uid;
      }

      match /eventViews/{eventId} {
        allow read: if isSelf(uid);

        allow create: if isVerifiedActiveUser()
          && request.auth.uid == uid
          && request.resource.data.keys().hasOnly(['id', 'eventId', 'userId', 'createdAt'])
          && request.resource.data.id == eventId
          && request.resource.data.eventId == eventId
          && request.resource.data.userId == uid
          && request.resource.data.createdAt == request.time
          && exists(/databases/$(database)/documents/events/$(eventId))
          && get(/databases/$(database)/documents/events/$(eventId)).data.moderationStatus == 'approved';

        allow update: if false;

        // View markers are immutable deduplication records. Account/content
        // cleanup runs with Admin credentials and does not need client access.
        allow delete: if false;
      }

      match /newsViews/{newsId} {
        allow read: if isSelf(uid);

        allow create: if isVerifiedActiveUser()
          && request.auth.uid == uid
          && request.resource.data.keys().hasOnly(['id', 'newsId', 'userId', 'createdAt'])
          && request.resource.data.id == newsId
          && request.resource.data.newsId == newsId
          && request.resource.data.userId == uid
          && request.resource.data.createdAt == request.time
          && exists(/databases/$(database)/documents/news/$(newsId))
          && get(/databases/$(database)/documents/news/$(newsId)).data.moderationStatus == 'approved';

        allow update: if false;

        // View markers are immutable deduplication records. Account/content
        // cleanup runs with Admin credentials and does not need client access.
        allow delete: if false;
      }

      match /recentViews/{recentViewId} {
        allow read: if isSelf(uid);

        allow create, update: if safeRecentViewWrite(uid, recentViewId);

        allow delete: if isVerifiedActiveUser()
          && request.auth.uid == uid;
      }

      match /activityLog/{activityLogId} {
        allow read: if isSelf(uid);

        allow create: if safeActivityLogWrite(uid, activityLogId);

        allow update: if false;

        allow delete: if isVerifiedActiveUser()
          && request.auth.uid == uid;
      }
    }

    match /news/{newsId} {
      allow read: if isApprovedContent()
        || canReadOwnScheduledDraft(resource.data)
        || canReadModerationQueue('news')
        || canReadOrganizationModerationQueue(resource.data);
      allow create: if validNewsDocument(request.resource.data, newsId)
        && hasValidPublicationSchedule(request.resource.data)
        && canCreateOrganizationContent()
        && request.resource.data.authorId is string
        && request.resource.data.authorId == request.auth.uid
        && (
          (request.resource.data.moderationStatus == 'draft'
            && request.resource.data.scheduledAt is timestamp
            && request.resource.data.scheduledAt > request.time)
          || (request.resource.data.moderationStatus == 'pendingReview'
            && request.resource.data.regionScope == 'austria'
            && !('scheduledAt' in request.resource.data))
          || (request.resource.data.moderationStatus == 'approved'
            && !('scheduledAt' in request.resource.data)
            && (!('regionScope' in request.resource.data)
              || request.resource.data.regionScope != 'austria'
              || canUseOrganizationOverride()))
        );
      allow delete: if false;
      allow update: if onlyModerationStatusChanged()
        ? canModerateAppContent('news')
        : (validNewsDocument(request.resource.data, newsId)
          && (canUpdateOrganizationContent() || canUpdateAppContent())
          && request.resource.data.id == resource.data.id
          && (
            (!('authorId' in resource.data) && !('authorId' in request.resource.data))
            || (
              ('authorId' in resource.data)
              && ('authorId' in request.resource.data)
              && request.resource.data.authorId == resource.data.authorId
            )
          )
          && request.resource.data.createdAt == resource.data.createdAt
          && (
            (request.resource.data.moderationStatus == resource.data.moderationStatus
              && (
                resource.data.moderationStatus != 'approved'
                || !('regionScope' in request.resource.data)
                || request.resource.data.regionScope != 'austria'
                || canUseOrganizationOverride()
              ))
            || (
              resource.data.moderationStatus == 'approved'
              && request.resource.data.moderationStatus == 'pendingReview'
              && request.resource.data.regionScope == 'austria'
            )
          ));

      match /comments/{commentId} {
        allow read: if get(/databases/$(database)/documents/news/$(newsId)).data.moderationStatus == 'approved'
          || canReadModerationQueue('news');

        // Comment text is created and edited only by the saveComment callable,
        // which performs the server-side objectionable-content check. Admin SDK
        // writes bypass Rules; direct clients cannot bypass that filter.
        allow create: if false;

        allow update: if false;

        allow delete: if canModerateNewsComment(newsId);
      }
    }

    match /events/{eventId} {
      allow read: if isApprovedContent()
        || canReadOwnScheduledDraft(resource.data)
        || canReadCancelledRegisteredEvent(eventId)
        || canReadModerationQueue('events')
        || canReadOrganizationModerationQueue(resource.data);
      allow create: if validEventDocument(request.resource.data, eventId)
        && hasValidPublicationSchedule(request.resource.data)
        && canCreateOrganizationContent()
        && request.resource.data.requiresRegistration is bool
        && (!('authorId' in request.resource.data)
          || request.resource.data.authorId == request.auth.uid)
        && (
          (request.resource.data.moderationStatus == 'draft'
            && request.resource.data.scheduledAt is timestamp
            && request.resource.data.scheduledAt > request.time)
          || (request.resource.data.moderationStatus == 'approved'
            && !('scheduledAt' in request.resource.data))
        );
      allow delete: if false;
      allow update: if onlyModerationStatusChanged()
        ? canModerateAppContent('events')
        : (validEventDocument(request.resource.data, eventId)
          && (canUpdateOrganizationContent() || canUpdateAppContent())
          && request.resource.data.id == resource.data.id
          && request.resource.data.createdAt == resource.data.createdAt
          && request.resource.data.moderationStatus == resource.data.moderationStatus);

      match /comments/{commentId} {
        allow read: if get(/databases/$(database)/documents/events/$(eventId)).data.moderationStatus == 'approved'
          || canReadModerationQueue('events');

        allow create: if false;

        allow update: if false;

        allow delete: if canModerateEventComment(eventId);
      }
    }

    match /organizations/{organizationId} {
      allow get: if canReadOrganization(organizationId);
      allow list: if canListOrganization();
      allow create: if safeOrganizationCreate(organizationId);
      allow delete: if false;
      allow update: if resource.data.moderationStatus in ['pendingReview', 'needsRevision', 'rejected']
        ? safeOrganizationRequestUpdate()
        : safeOrganizationInfoUpdate(organizationId);

      match /photos/{photoId} {
        allow read: if canReadOrganizationByLookup(organizationId);
        // Metadata mutations are serialized by callable functions so the
        // 30-photo limit cannot be bypassed by concurrent clients.
        allow create, update, delete: if false;
      }

      match /comments/{commentId} {
        allow read: if canReadOrganizationByLookup(organizationId);

        allow create: if false;

        allow update: if false;

        allow delete: if canModerateOrganizationComment(organizationId);
      }
    }

    match /likes/{likeId} {
      allow read: if ownDocumentRead()
        || ownLikeDocumentRead(likeId)
        || canReadOrganizationSubscription()
        || isOwner();

      allow create: if validLikeCreate(likeId);

      allow update: if false;

      allow delete: if ownDocumentDelete()
        || isOwner();
    }

    match /registrations/{registrationId} {
      allow read: if ownDocumentRead()
        || canReadManagedEventRegistration()
        || isOwner();

      // Registration membership and registeredCount are one server-owned invariant.
      // Clients must use registerForEvent/unregisterFromEvent callable functions.
      allow create, update, delete: if false;
    }

    match /feedback/{feedbackId} {
      allow read: if canManageFeedback()
        || (isSignedIn() && resource.data.userId == request.auth.uid);

      allow create: if safeFeedbackCreate(feedbackId);

      allow update: if safeFeedbackOwnerUpdate()
        || safeFeedbackUserReplyUpdate();

      // Cascading deletion of messages and linked notifications is server-owned.
      allow delete: if false;

      match /messages/{messageId} {
        allow read: if canReadFeedback(feedbackId);

        allow create: if safeFeedbackMessageCreate(feedbackId, messageId);

        allow update, delete: if false;
      }
    }

    // DSA case files contain reporter contact details, access-token hashes and
    // legal evidence. They are available only through audited server endpoints.
    match /dsaCases/{caseId} {
      allow read, create, update, delete: if false;
    }

    match /dsaPortalRateLimits/{rateLimitId} {
      allow read, create, update, delete: if false;
    }

    match /systemLogs/{systemLogId} {
      // Full-text search is intentionally unsupported. Future searchText can be
      // applied client-side on loaded pages or through explicit search tokens.
      allow read: if canReadSystemLog(resource.data);

      allow create: if validSystemLogClientCreate(systemLogId);

      allow update: if validSystemLogReviewUpdate();

      allow delete: if false;
    }

    match /analyticsDailyStats/{statsId} {
      allow read: if isOwner();
      allow create, update, delete: if false;
    }

    // A proof is a short-lived, create-only bridge between an operational
    // action and delayed analytics delivery. Clients cannot read or mutate it.
    match /analyticsActionProofs/{proofId} {
      allow read, update, delete: if false;
      allow create: if validAnalyticsActionProofCreate(proofId);
    }

    match /analyticsConsentStates/{userId} {
      allow read, create, update, delete: if false;
    }

    match /analyticsConsentReceipts/{receiptId} {
      allow read, create, update, delete: if false;
    }

    match /analyticsTopContent/{periodId} {
      allow read: if isOwner();
      allow create, update, delete: if false;
    }

    match /analyticsRegionStats/{periodId} {
      allow read: if isOwner();
      allow create, update, delete: if false;
    }

    match /analyticsUserStats/{periodId} {
      allow read: if isOwner();
      allow create, update, delete: if false;
    }

    match /analyticsContentStats/{periodId} {
      allow read: if isOwner();
      allow create, update, delete: if false;

      match /items/{itemId} {
        allow read: if isOwner();
        allow create, update, delete: if false;
      }
    }

    match /analyticsOrganizationStats/{periodId} {
      allow read: if isOwner();
      allow create, update, delete: if false;

      match /organizations/{organizationId} {
        allow read: if isOwner();
        allow create, update, delete: if false;
      }
    }

    // Short-lived, server-only activity markers and idempotent lifecycle events
    // feed restricted aggregate metrics. Interaction activity is consent-based;
    // account registration/deletion totals are operational statistics for all
    // accounts. These marker documents are never client-readable or writable.
    match /analyticsUserActivity/{userId} {
      allow read, create, update, delete: if false;
    }

    match /analyticsDeletedUserEvents/{eventId} {
      allow read, create, update, delete: if false;
    }

    match /analyticsUserRegistrationEvents/{eventId} {
      allow read, create, update, delete: if false;
    }

    match /analyticsAggregateCleanupState/{collectionId} {
      allow read, create, update, delete: if false;
    }

    match /analyticsSchemaState/{documentId} {
      allow read, create, update, delete: if false;
    }

    match /analyticsSchemaCutoverArchives/{document=**} {
      allow read, create, update, delete: if false;
    }

    match /analyticsUserLifecycleBaselines/{documentId} {
      allow read, create, update, delete: if false;
    }

    // Per-source counter transition/tombstone state is an Admin-SDK-only
    // idempotency boundary. It must never be observable or mutable by clients.
    match /counterAggregationSourceStates/{stateId} {
      allow read, create, update, delete: if false;
    }

    // Immutable migration baselines preserve lifetime view totals that cannot
    // be reconstructed after account-owned view markers have been deleted.
    match /counterAggregationBaselines/{baselineId} {
      allow read, create, update, delete: if false;
    }

    // Permanent invariant violations are acknowledged into a server-only
    // dead-letter queue so retry:true cannot loop forever on poison events.
    match /counterAggregationDeadLetters/{deadLetterId} {
      allow read, create, update, delete: if false;
    }

    match /auditLogs/{auditLogId} {
      allow read: if canManageUsers();

      allow create: if isOwner()
        && request.resource.data.actionType in [
          'warningIssued',
          'suspended',
          'banned',
          'unblocked',
          'deactivated'
        ]
        && request.resource.data.targetUserId is string
        && request.resource.data.performedBy == request.auth.uid
        && request.resource.data.createdAt is timestamp
        && request.resource.data.reason is string
        && request.resource.data.previousValue is map
        && request.resource.data.newValue is map;

      allow update, delete: if false;
    }

    match /appConfig/{configId} {
      allow read: if configId == 'donation';
      allow create, update: if configId == 'donation'
        && validDonationConfigWrite();
      allow delete: if false;
    }

    match /featuredBanners/{bannerId} {
      allow read: if canManageFeaturedBanners() || canReadFeaturedBanner();
      allow create: if validFeaturedBannerCreate(bannerId);
      allow update: if validFeaturedBannerUpdate(bannerId);
      allow delete: if isVerifiedActiveUser()
        && canManageFeaturedBanners();
    }

    match /{document=**} {
      allow read, write: if false;
    }
  }
}
