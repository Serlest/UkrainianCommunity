{
  "name": "ukrainian-community-functions",
  "private": true,
  "engines": {
    "node": "22"
  },
  "main": "lib/index.js",
  "scripts": {
    "build": "tsc",
    "lint": "tsc --noEmit",
    "audit:prod": "npm audit --omit=dev --audit-level=high",
    "audit:removed-guide-data": "node scripts/auditRemovedGuideData.mjs",
    "test:unit": "npm run build && npm run test:unit:compiled",
    "test:unit:compiled": "node --test lib/analytics/*.test.js lib/content/*.test.js lib/featured/*.test.js lib/retention/*.test.js lib/users/*.test.js scripts/*.test.mjs",
    "test:retention": "node --test lib/retention/dataRetention.test.js",
    "test:rules": "npm run test:rules:all",
    "test:rules:all": "firebase emulators:exec --project demo-ukrainian-community-rules --only firestore,storage \"node --test smoke-tests/*.test.mjs\"",
    "test:rules:storage": "firebase emulators:exec --project demo-ukrainian-community-rules --only firestore,storage \"node --test smoke-tests/storageRules.test.mjs\"",
    "test:rules:contentDeletion": "firebase emulators:exec --project demo-ukrainian-community-content-deletion --only firestore \"node --test smoke-tests/contentDeletionRules.test.mjs\"",
    "test:rules:systemLogs": "firebase emulators:exec --only firestore \"node --test smoke-tests/systemLogsRules.test.mjs\"",
    "test:rules:cancelledEvents": "firebase emulators:exec --only firestore \"node --test smoke-tests/cancelledEventRules.test.mjs\"",
    "test:rules:emailVerification": "firebase emulators:exec --only firestore \"node --test smoke-tests/emailVerificationRules.test.mjs\"",
    "test:rules:organizationSubscriptions": "firebase emulators:exec --only firestore \"node --test smoke-tests/organizationSubscriptionRules.test.mjs\"",
    "test:rules:roleContract": "firebase emulators:exec --only firestore \"node --test smoke-tests/roleContractSmoke.test.mjs\""
  },
  "dependencies": {
    "firebase-admin": "^14.3.0",
    "firebase-functions": "^7.3.2"
  },
  "devDependencies": {
    "@firebase/rules-unit-testing": "^4.0.1",
    "firebase": "^11.0.0",
    "typescript": "^5.7.0"
  }
}
