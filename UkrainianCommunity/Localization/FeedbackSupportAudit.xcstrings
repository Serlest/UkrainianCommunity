    "feedback_audit.personal_subtitle": {
      "extractionState": "manual",
      "localizations": {
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Ваші звернення та відповіді команди підтримки."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Ihre Anfragen und Antworten des Supportteams."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Your requests and replies from the support team."
          }
        }
      }
    },
    "feedback_audit.composer_subtitle": {
      "extractionState": "manual",
      "localizations": {
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Надішліть запитання, пропозицію або повідомлення про проблему команді підтримки."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Senden Sie dem Supportteam eine Frage, einen Vorschlag oder eine Problembeschreibung."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Send a question, suggestion or problem to the support team."
          }
        }
      }
    }
  },
  "version": "1.0"
}
