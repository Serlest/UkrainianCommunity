{
  "sourceLanguage": "en",
  "strings": {
    "feedback_audit.loaded_scope": {
      "extractionState": "manual",
      "localizations": {
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Пошук і фільтри застосовуються до завантажених звернень. Завантажте попередні, щоб розширити результати."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Suche und Filter gelten für geladene Anfragen. Laden Sie ältere Anfragen, um die Ergebnisse zu erweitern."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Search and filters apply to loaded requests. Load older requests to expand the results."
          }
        }
      }
    },
    "feedback_audit.appeal_reason": {
      "extractionState": "manual",
      "localizations": {
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Чому це рішення слід переглянути?"
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Warum soll diese Entscheidung überprüft werden?"
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Why should this decision be reviewed?"
          }
        }
      }
    },
    "feedback_audit.conversation": {
      "extractionState": "manual",
      "localizations": {
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Звернення"
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Anfrage"
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Request"
          }
        }
      }
    },
