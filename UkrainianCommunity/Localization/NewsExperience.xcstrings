      "localizations": {
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Зміни в цій новині ще не збережено."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Die Änderungen an dieser Nachricht wurden noch nicht gespeichert."
