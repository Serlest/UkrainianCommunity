{
  "sourceLanguage": "de",
  "strings": {
    "legal_evidence_ui.about": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Über diese Nachweise"
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Про ці підтвердження"
          }
        }
      }
    },
