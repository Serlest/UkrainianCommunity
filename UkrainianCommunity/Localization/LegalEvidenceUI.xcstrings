      }
    },
    "legal_evidence_ui.outdated": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Frühere Version bestätigt"
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Підтверджено попередню версію"
