    "app_lock.registration_failed" : {
      "extractionState" : "manual",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Der Schutz wurde nicht aktiviert. Versuchen Sie es erneut oder setzen Sie die Registrierung ohne ihn fort."
          }
        },
        "uk" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Захист не ввімкнено. Спробуйте ще раз або продовжуйте реєстрацію без нього."
          }
        }
      }
    },
    "app_lock.registration_help" : {
      "extractionState" : "manual",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Optional. Bestätigen Sie den Schutz mit Face ID, Touch ID oder dem Gerätecode. Er wird nach erfolgreicher Registrierung für dieses Konto auf diesem Gerät aktiviert. Sie können ihn später in den Profileinstellungen ein- oder ausschalten. Die Anmeldung mit E-Mail und Passwort bleibt verfügbar."
          }
        },
        "uk" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Необов’язково. Підтвердьте захист через Face ID, Touch ID або код пристрою. Він увімкнеться для цього акаунта на цьому пристрої після успішної реєстрації. Згодом його можна ввімкнути або вимкнути в налаштуваннях профілю. Звичайний вхід з email і паролем залишається доступним."
          }
        }
      }
    },
    "app_lock.registration_title" : {
      "extractionState" : "manual",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Face ID / Touch ID aktivieren"
          }
        },
        "uk" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Увімкнути Face ID / Touch ID"
          }
        }
      }
    },
    "app_lock.settings_help" : {
      "extractionState" : "manual",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Nach dem Wechsel in den Hintergrund wird der Zugriff auf dieses Konto auf diesem Gerät mit Face ID, Touch ID oder dem Gerätecode geschützt. Nach dem Abmelden sind E-Mail und Passwort erneut erforderlich."
          }
        },
        "uk" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Після згортання застосунку доступ до цього акаунту на цьому пристрої потребуватиме Face ID, Touch ID або коду пристрою. Після виходу з акаунту потрібно знову ввести email і пароль."
