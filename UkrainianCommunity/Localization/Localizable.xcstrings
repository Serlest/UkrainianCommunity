    },
    "guide.editor.help.body_fallback" : {
      "extractionState" : "manual",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Der Haupttext ist Ersatzinhalt. Lesende sehen ihn nur, wenn unten keine Inhaltsblöcke hinzugefügt wurden."
          }
        },
        "uk" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Основний текст є резервним вмістом. Читачі бачать його лише тоді, коли нижче не додано блоків контенту."
          }
        }
      }
    },
    "guide.editor.help.content_blocks" : {
      "extractionState" : "manual",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Wenn Inhaltsblöcke vorhanden sind, sehen Lesende die Blöcke statt des Haupttexts. Blöcke werden in der unten gezeigten Reihenfolge dargestellt."
          }
        },
        "uk" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Якщо є блоки контенту, читачі бачать блоки замість основного тексту. Блоки відображаються в наведеному нижче порядку."
          }
        }
      }
    },
    "guide.editor.help.summary" : {
      "extractionState" : "manual",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Verwenden Sie ein oder zwei kurze Sätze. Dies erscheint in Karten und unter dem Artikeltitel."
