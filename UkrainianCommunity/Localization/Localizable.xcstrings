    "guide.editor.help.article_source_links" : {
      "extractionState" : "manual",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Wenn offizielle Quellen erforderlich sind, fügen Sie mindestens eine Artikelquelle hinzu und markieren Sie sie als offizielle Quelle."
          }
        },
        "uk" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Якщо ввімкнено вимогу офіційних джерел, додайте принаймні одне джерело статті й позначте його як офіційне."
