    "mock.org.1.description" : {
      "extractionState" : "manual",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Community-Unterstützung, Sprachaustausch und kulturelle Veranstaltungen. Aufbau eines stabilen Unterstützungsnetzwerks für Ukrainerinnen und Ukrainer in Tirol durch Information, kulturelle Kontinuität und lokale Partnerschaften."
