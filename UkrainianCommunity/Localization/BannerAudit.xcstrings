    "banners14.help": {
      "extractionState": "manual",
      "localizations": {
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Час Австрії (Europe/Vienna). Відлік працює без додаткових запитів до сервера."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Österreichische Zeit (Europe/Vienna). Der Countdown benötigt keine laufenden Serverabfragen."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Austria time (Europe/Vienna). The countdown needs no ongoing server requests."
          }
        }
      }
    },
    "banners14.hideHelp": {
      "extractionState": "manual",
      "localizations": {
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Показ банера завершиться не пізніше вказаного часу події, зокрема в попередніх версіях застосунку."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Der Banner endet spätestens zum Ereigniszeitpunkt, auch in älteren App-Versionen."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "The banner ends by the event time, including in older app versions."
          }
        }
      }
    },
    "banners14.invalid": {
      "extractionState": "manual",
      "localizations": {
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Перевірте дату відліку та довжину підписів (до 40 символів). Подія має бути пізніше початку показу."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Countdown-Datum und Beschriftungen prüfen (bis zu 40 Zeichen). Das Ereignis muss nach dem Anzeigebeginn liegen."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Check the countdown date and labels (up to 40 characters). The event must follow the display start."
          }
        }
      }
    },
