    "seasonal.offline": {
      "extractionState": "manual",
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Bereits geladene Pakete funktionieren offline. Ein vorzeitiges Ausschalten erreicht offline befindliche Geräte erst bei der nächsten Verbindung."
