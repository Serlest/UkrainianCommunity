      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Die Vorschau zeigt das Thema sofort, unabhängig vom Zeitplan. Nur Sie sehen diese Änderungen."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Передперегляд одразу показує тему незалежно від розкладу. Ці зміни бачите лише ви."
