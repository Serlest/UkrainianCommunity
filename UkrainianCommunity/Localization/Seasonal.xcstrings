    "seasonal.publicationHint": {
      "extractionState": "manual",
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Veröffentlicht werden nur gespeicherte, eingeschaltete Themen. Beginn und Ende gelten in der gewählten Zeitzone. Bei Überschneidung gewinnt die höhere Priorität."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Публікуються лише збережені й увімкнені теми. Початок і кінець діють у вибраному часовому поясі. Якщо періоди збігаються, перевагу має вищий пріоритет."
          }
        }
      }
    },
