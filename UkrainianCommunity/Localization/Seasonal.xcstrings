      "localizations": {
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Великі прикраси залишаються на головних сторінках. Сніг може продовжуватися всередині розділів. Під час введення тексту ефекти приховуються."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Large decorations stay on main pages. Snow can continue through details. Effects hide during text entry."
          }
