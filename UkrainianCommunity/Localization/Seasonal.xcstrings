    "seasonal.scenePlacement": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Ruhendes Ecknetz und Herbstlaub. Eine Spinne hängt am Netz, eine am oberen Ausschnitt. Der Kürbis glimmt neben dem Logo; Fledermäuse fliegen selten vorbei."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "A still corner web and autumn leaves. One spider hangs from the web, another below the top cutout. The pumpkin glows beside the logo; bats pass occasionally."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Нерухома кутова павутинка й осіннє листя. Один павук висить на павутинці, другий — під верхнім вирізом. Гарбуз жевріє біля логотипа; кажани зрідка пролітають повз."
          }
        }
      }
    },
