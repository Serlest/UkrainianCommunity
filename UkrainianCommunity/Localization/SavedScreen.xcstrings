      "extractionState": "manual",
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Ein Teil der gespeicherten Inhalte ist geladen. Suche, Sortierung und Zähler gelten für geladene Einträge."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Завантажено частину збереженого. Пошук, сортування й лічильники стосуються завантажених записів."
          }
        }
      }
    },
