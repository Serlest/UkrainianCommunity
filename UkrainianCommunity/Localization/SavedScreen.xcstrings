      "extractionState": "manual",
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Gespeicherte Inhalte konnten nicht geladen werden. Prüfen Sie Ihre Verbindung und versuchen Sie es erneut."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Не вдалося завантажити збережене. Перевірте з’єднання та спробуйте ще раз."
          }
        }
      }
    },
