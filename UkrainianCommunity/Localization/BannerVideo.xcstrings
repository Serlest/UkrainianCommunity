{
  "sourceLanguage": "de",
  "strings": {
    "video": {
      "localizations": {
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Відео або GIF"
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Video oder GIF"
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Video or GIF"
          }
        }
      }
    },
    "chooseRequired": {
      "localizations": {
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Виберіть відео або вимкніть відеорежим."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Wählen Sie ein Video oder schalten Sie den Videomodus aus."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Choose a video or turn video mode off."
          }
        }
      }
    },
    "choose": {
      "localizations": {
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Вибрати з медіатеки"
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Aus Mediathek wählen"
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Choose from library"
          }
        }
      }
    },
    "file": {
      "localizations": {
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Вибрати файл"
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Datei auswählen"
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Choose a file"
          }
        }
      }
    },
    "helper": {
      "localizations": {
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "До 15 секунд. Відео запускається без звуку; обкладинка залишається видимою до завантаження. Початковий файл — до 50 МіБ і 60 секунд."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Bis zu 15 Sekunden. Start ohne Ton; das Titelbild bleibt bis zum Laden sichtbar. Quelldatei: bis 50 MiB und 60 Sekunden."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Up to 15 seconds. Starts muted; the poster stays visible until loaded. Source file: up to 50 MiB and 60 seconds."
          }
        }
      }
    },
    "preparing": {
      "localizations": {
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Готуємо відео…"
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Video wird vorbereitet…"
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Preparing video…"
          }
        }
      }
    },
    "error": {
      "localizations": {
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Не вдалося підготувати відео. Виберіть відео або GIF до 50 МіБ, тривалістю від 1 до 60 секунд."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Video konnte nicht vorbereitet werden. Wählen Sie ein Video oder GIF mit 1–60 Sekunden und höchstens 50 MiB."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Could not prepare the video. Choose a video or GIF lasting 1–60 seconds and at most 50 MiB."
          }
        }
      }
    },
    "start": {
      "localizations": {
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Початок відрізка"
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Beginn des Ausschnitts"
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Clip start"
          }
        }
      }
    },
    "duration": {
      "localizations": {
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Тривалість відрізка"
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Länge des Ausschnitts"
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Clip duration"
          }
        }
      }
    },
    "apply": {
      "localizations": {
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Підготувати відрізок"
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Ausschnitt vorbereiten"
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Prepare clip"
          }
        }
      }
    },
    "crop": {
      "localizations": {
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Вертикальне та квадратне відео кадрується по центру до 16:9. Перевірте обкладинку перед збереженням."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Hochformat und quadratische Videos werden mittig auf 16:9 zugeschnitten. Prüfen Sie das Titelbild vor dem Speichern."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Portrait and square videos are center-cropped to 16:9. Check the poster before saving."
          }
        }
      }
    },
    "preview": {
      "localizations": {
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Переглянути відео"
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Video ansehen"
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Preview video"
          }
        }
      }
    },
    "unmute": {
      "localizations": {
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Увімкнути звук"
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Ton einschalten"
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Unmute"
          }
        }
      }
    },
    "mute": {
      "localizations": {
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Вимкнути звук"
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Ton ausschalten"
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Mute"
          }
        }
      }
    },
    "expand": {
      "localizations": {
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "На весь екран"
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Vollbild"
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Full screen"
          }
        }
      }
    },
    "close": {
      "localizations": {
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Закрити відео"
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Video schließen"
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Close video"
          }
        }
      }
    },
    "open": {
      "localizations": {
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Перейти"
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Öffnen"
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Open link"
          }
        }
      }
    },
    "play": {
      "localizations": {
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Відтворити"
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Abspielen"
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Play"
          }
        }
      }
    },
    "pause": {
      "localizations": {
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Пауза"
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Pause"
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Pause"
          }
        }
      }
    },
    "unavailable": {
      "localizations": {
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Відео зараз недоступне."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Das Video ist derzeit nicht verfügbar."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Video is currently unavailable."
          }
        }
      }
    },
    "soundHint": {
      "localizations": {
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Звук вимикається після виходу з баннера."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Der Ton wird beim Verlassen des Banners ausgeschaltet."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Sound turns off when you leave the banner."
          }
        }
      }
    },
    "autoplay": {
      "localizations": {
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Автовідтворення відеобанерів"
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Videobanner automatisch abspielen"
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Autoplay video banners"
          }
        }
      }
    },
    "autoplayHint": {
      "localizations": {
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Без звуку. Якщо вимкнути, відображатиметься обкладинка; відео можна відкрити окремо."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Ohne Ton. Wenn ausgeschaltet, erscheint das Titelbild; das Video lässt sich separat öffnen."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Muted. When off, the poster is shown; you can still open the video separately."
          }
        }
      }
    },
    "notEnabled": {
      "localizations": {
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Відеобанери ще не увімкнено на сервері. Фотобанери працюють як раніше."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Videobanner sind serverseitig noch nicht aktiviert. Bildbanner funktionieren wie bisher."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Video banners are not enabled on the server yet. Image banners work as before."
          }
        }
      }
    },
    "gifTooComplex": {
      "localizations": {
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "GIF потребує забагато пам’яті. Зменште роздільність або кількість кадрів і спробуйте знову."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Das GIF benötigt zu viel Arbeitsspeicher. Verringern Sie Auflösung oder Bildanzahl und versuchen Sie es erneut."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "This GIF needs too much memory. Reduce its resolution or frame count and try again."
          }
        }
      }
    },
    "tooLarge": {
      "localizations": {
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Підготовлений ролик завеликий. Скоротіть відрізок або виберіть простіше відео."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Das vorbereitete Video ist zu groß. Kürzen Sie den Ausschnitt oder wählen Sie ein anderes Video."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "The prepared clip is too large. Shorten it or choose a simpler video."
          }
        }
      }
    },
    "retry": {
      "localizations": {
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Спробувати знову"
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Erneut versuchen"
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Try again"
          }
        }
      }
    }
  },
  "version": "1.0"
}
