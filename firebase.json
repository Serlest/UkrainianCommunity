{
  "auth": {
    "providers": {
      "emailPassword": true,
      "googleSignIn": {
        "oAuthBrandDisplayName": "UAC — Ukrainian Community",
        "supportEmail": "ukrainian.community@outlook.com"
      }
    }
  },
  "firestore": {
    "rules": "Firebase/firestore.rules",
    "indexes": "Firebase/firestore.indexes.json"
  },
  "storage": {
    "rules": "Firebase/storage.rules"
  },
  "functions": {
    "source": "functions",
    "runtime": "nodejs22",
    "predeploy": [
      "npm --prefix \"$RESOURCE_DIR\" run lint",
      "npm --prefix \"$RESOURCE_DIR\" run build"
    ],
    "ignore": [
      "node_modules",
      "content-planning",
      "scripts",
      "smoke-tests",
      ".git",
      "firebase-debug.log",
      "firebase-debug.*.log",
      "*.local"
    ]
  },
  "emulators": {
    "hosting": {"port": 5057}
  },
  "hosting": {
    "public": "website",
    "cleanUrls": true,
    "trailingSlash": false,
    "ignore": [
      "firebase.json",
      "**/.DS_Store",
      "**/.git/**",
      "**/node_modules/**",
      "terms/**",
      "privacy/**",
      "organization-rules/**"
    ],
    "rewrites": [
      {"source": "/terms", "function": {"functionId": "serveLegalDocument", "region": "europe-west3"}},
      {"source": "/terms/**", "function": {"functionId": "serveLegalDocument", "region": "europe-west3"}},
      {"source": "/privacy", "function": {"functionId": "serveLegalDocument", "region": "europe-west3"}},
      {"source": "/privacy/**", "function": {"functionId": "serveLegalDocument", "region": "europe-west3"}},
      {"source": "/organization-rules", "function": {"functionId": "serveLegalDocument", "region": "europe-west3"}},
      {"source": "/organization-rules/**", "function": {"functionId": "serveLegalDocument", "region": "europe-west3"}},
      {
        "source": "/api/dsa",
        "function": {
          "functionId": "dsaCasePortal",
          "region": "europe-west3"
        }
      }
    ],
    "headers": [
      {
        "source": "/.well-known/apple-app-site-association",
        "headers": [
          {"key": "Content-Type", "value": "application/json"},
          {"key": "Cache-Control", "value": "public, max-age=3600"}
        ]
      },
      {
        "source": "**",
        "headers": [
          {
            "key": "X-Content-Type-Options",
            "value": "nosniff"
          },
          {
            "key": "Referrer-Policy",
            "value": "strict-origin-when-cross-origin"
          },
          {
            "key": "Permissions-Policy",
            "value": "camera=(), microphone=(), geolocation=()"
          },
          {
            "key": "Content-Security-Policy",
            "value": "default-src 'self'; script-src 'self'; style-src 'self'; img-src 'self' data:; connect-src 'self'; object-src 'none'; base-uri 'self'; form-action 'self'; frame-ancestors 'none'; upgrade-insecure-requests"
          }
        ]
      },
      {
        "source": "/assets/**",
        "headers": [
          {
            "key": "Cache-Control",
            "value": "public, max-age=3600"
          }
        ]
      }
    ]
  }
}
